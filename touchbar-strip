class AppIcons:
    """Each app's own icon: its .desktop entry (by StartupWMClass, the file's name, or the address
    of an Omarchy web app) -> Icon= -> a file in the icon theme (the desktop's theme and what it
    inherits, then hicolor). Looked up once per class; rendered once per size."""

    APPS = [HOME / ".local/share/applications", Path("/usr/share/applications"),
            HOME / ".local/share/flatpak/exports/share/applications",
            Path("/var/lib/flatpak/exports/share/applications")]
    ICON_ROOTS = [HOME / ".local/share/icons", HOME / ".icons", Path("/usr/share/icons")]
    SIZES = ["scalable/apps", "256x256/apps", "512x512/apps", "128x128/apps", "96x96/apps",
             "64x64/apps", "48x48/apps", "apps/scalable", "apps/48", "32x32/apps"]

    def __init__(self):
        self._entries, self._themes = None, None
        self._found, self._files, self._surfaces = {}, {}, {}

    def _index(self):
        if self._entries is None:
            entries = []
            for folder in self.APPS:
                for f in sorted(folder.glob("*.desktop")) if folder.is_dir() else []:
                    try:
                        text = f.read_text(errors="replace")
                    except OSError:
                        continue
                    e = {"id": f.stem}
                    for line in text.split("[Desktop Entry]", 1)[-1].split("\n[", 1)[0].splitlines():
                        k, _, v = line.partition("=")
                        if k in ("Icon", "StartupWMClass", "Exec", "Name"):
                            e.setdefault(k, v.strip())
                    if e.get("Icon"):
                        entries.append(e)
            self._entries = entries
        return self._entries

    def _theme_chain(self):
        if self._themes is None:
            name = None
            try:
                name = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "icon-theme"],
                                      capture_output=True, text=True, timeout=2,
                                      env=desktop_env()).stdout.strip().strip("'") or None
            except (OSError, subprocess.SubprocessError):
                pass
            chain, todo = [], [name] if name else []
            while todo:
                t = todo.pop(0)
                if t in chain or len(chain) > 8:
                    continue
                chain.append(t)
                for root in self.ICON_ROOTS:
                    try:
                        idx = (root / t / "index.theme").read_text(errors="replace")
                    except OSError:
                        continue
                    m = re.search(r"^Inherits=(.*)$", idx, re.M)
                    todo += [s.strip() for s in m.group(1).split(",")] if m else []
                    break
            self._themes = [t for t in chain if t != "hicolor"] + ["hicolor"]
        return self._themes

    def entry(self, cls=None, desktop=None):
        """The .desktop entry for a window class, or for a desktop id ("terminal" = the
        terminal xdg-terminal-exec opens, as Omarchy's terminal key does)."""
        key = (cls, desktop)
        if key in self._found:
            return self._found[key]
        entries, found = self._index(), None
        if desktop == "terminal":
            try:
                lines = (HOME / ".config/xdg-terminals.list").read_text().splitlines()
                desktop = next((ln.strip().removesuffix(".desktop") for ln in lines
                                if ln.strip() and not ln.lstrip().startswith("#")), None)
            except OSError:
                desktop = None
        if desktop:
            found = next((e for e in entries if e["id"] == desktop), None)
        elif cls:
            low = cls.lower()
            m = re.match(r"(?:chrome|brave|msedge)-(?:app\.)?([^_]+)__", cls)
            host = m.group(1) if m else None
            for test in (lambda e: e.get("StartupWMClass", "").lower() == low,
                         lambda e: e["id"].lower() == low,
                         lambda e: bool(host) and f"//{host}" in e.get("Exec", ""),
                         lambda e: e["id"].lower().rsplit(".", 1)[-1] == low.rsplit(".", 1)[-1],
                         lambda e: e.get("Icon", "").lower() == low):
                found = next((e for e in entries if test(e)), None)
                if found:
                    break
        self._found[key] = found
        return found

    def file(self, name):
        if name in self._files:
            return self._files[name]
        found = None
        if name.startswith("/"):
            found = name if os.path.isfile(name) else None
        else:
            for theme in self._theme_chain():
                for root in self.ICON_ROOTS:
                    if found or not (root / theme).is_dir():
                        continue
                    for sub in self.SIZES:
                        hit = next((root / theme / sub / f"{name}.{ext}" for ext in ("svg", "png")
                                    if (root / theme / sub / f"{name}.{ext}").is_file()), None)
                        if hit:
                            found = str(hit)
                            break
                if found:
                    break
            for ext in ("svg", "png"):
                if not found and os.path.isfile(f"/usr/share/pixmaps/{name}.{ext}"):
                    found = f"/usr/share/pixmaps/{name}.{ext}"
        self._files[name] = found
        return found

    def draw(self, p, entry, cx, cy, size):
        """Draw an entry's icon centred at (cx, cy); False when it has none we can draw."""
        f = self.file(entry["Icon"]) if entry else None
        if not f:
            return False
        px = max(8, int(round(size)))
        surf = self._surfaces.get((f, px))
        if surf is None:
            if len(self._surfaces) > 300:
                self._surfaces.clear()
            surf = self._surfaces[(f, px)] = self._render(f, px)
        if not surf:
            return False
        p.cr.set_source_surface(surf, cx - px / 2, cy - px / 2)
        p.cr.paint()
        return True

    @staticmethod
    def _render(f, px):
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, px, px)
        cr = cairo.Context(surf)
        try:
            if f.endswith(".svg"):
                if Rsvg is None:
                    return False
                rect = Rsvg.Rectangle()
                rect.x, rect.y, rect.width, rect.height = 0, 0, px, px
                Rsvg.Handle.new_from_file(f).render_document(cr, rect)
            else:
                img = cairo.ImageSurface.create_from_png(f)
                k = px / max(img.get_width(), img.get_height())
                cr.scale(k, k)
                cr.set_source_surface(img, 0, 0)
                cr.get_source().set_filter(cairo.FILTER_GOOD)
                cr.paint()
        except Exception as e:                  # noqa: BLE001 - a broken icon falls back to a glyph
            _say_once(f"icon {f}: {e}")
            return False
        return surf


ICONS = AppIcons()


def hypr_socket(name):
    env = desktop_env()
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        return None
    return Path(env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hypr" / sig / name


def hypr_json(cmd):
    """One `hyprctl -j` request straight over Hyprland's socket (no process per call)."""
    path = hypr_socket(".socket.sock")
    if not path:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(1)
            s.connect(str(path))
            s.sendall(f"j/{cmd}".encode())
            chunks = []
            while True:
                b = s.recv(65536)
                if not b:
                    break
                chunks.append(b)
        return json.loads(b"".join(chunks) or b"null")
    except (OSError, ValueError):
        return None


def hypr_dispatch(lua, legacy):
    """A Hyprland dispatch in Omarchy's Lua form, the classic form when that is refused."""
    run_control(["sh", "-c", f"hyprctl dispatch {shlex.quote(lua)} >/dev/null 2>&1 || "
                             f"hyprctl dispatch {legacy} >/dev/null 2>&1"])


class Dock:
    """Windows and workspaces from Hyprland, kept fresh by its event socket (.socket2.sock): a
    window opening, closing, moving or taking focus redraws the dock at once. Polls every 2 s
    when the event socket is not there. Runs only while the dock zone is shown."""

    EVENTS = (b"openwindow", b"closewindow", b"activewindowv2", b"workspacev2", b"movewindowv2",
              b"createworkspacev2", b"destroyworkspacev2", b"focusedmonv2", b"activespecialv2")

    def __init__(self):
        self.clients, self.workspaces, self.active_ws, self.focus = [], {}, 1, None
        self.order = []                         # unpinned classes, in the order they first opened
        self.version = 0
        self._started = False

    def ensure(self):
        if not self._started and "dock" in CFG["zones"]:
            self._started = True
            self.refresh()
            threading.Thread(target=self._watch, daemon=True).start()

    def refresh(self):
        clients = hypr_json("clients")
        if not isinstance(clients, list):
            return
        ws = hypr_json("workspaces") or []
        aws = hypr_json("activeworkspace") or {}
        clients = [c for c in clients if c.get("mapped", True) and c.get("class")]
        focus = next((c["address"] for c in clients if c.get("focusHistoryID") == 0), None)
        state = (clients, {w.get("id"): w.get("windows", 0) for w in ws if isinstance(w, dict)},
                 aws.get("id", 1) if isinstance(aws, dict) else 1, focus)
        if state != (self.clients, self.workspaces, self.active_ws, self.focus):
            self.clients, self.workspaces, self.active_ws, self.focus = state
            live = {c["class"] for c in clients}
            self.order = [k for k in self.order if k in live] + \
                [k for k in dict.fromkeys(c["class"] for c in clients) if k not in self.order]
            self.version += 1

    def _watch(self):
        while True:
            path = hypr_socket(".socket2.sock")
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                    s.connect(str(path))
                    s.settimeout(10)            # a quiet desktop: refresh anyway now and then
                    buf = b""
                    while True:
                        try:
                            data = s.recv(65536)
                        except socket.timeout:
                            self.refresh()
                            continue
                        if not data:
                            break
                        buf += data
                        *lines, buf = buf.split(b"\n")
                        if any(line.split(b">>", 1)[0] in self.EVENTS for line in lines):
                            time.sleep(0.03)    # a burst (open + focus + move) is one refresh
                            self.refresh()
            except (OSError, TypeError):
                pass
            time.sleep(2)
            self.refresh()

    def windows(self, pattern):
        """This app's windows, the one most recently in front first."""
        try:
            rx = re.compile(pattern or r"(?!)")
        except re.error:
            return []
        return sorted((c for c in self.clients if rx.search(c["class"])),
                      key=lambda c: c.get("focusHistoryID", 99))


def dock_items(dock, agent):
    """What the dock shows, left to right: dicts with kind (logo, app, agent, rule, ws)."""
    d = CFG["dock"]
    prefix = (CFG.get("app_id_prefix") or DEFAULTS["app_id_prefix"]) + "."
    claude_rx = f"^{re.escape(app_id('claude'))}$"
    items, claimed = [{"kind": "logo", "name": "Omarchy", "w": DOCK_WS, "big": True}], set()
    pinned_agent = False
    for app in d.get("pinned") or []:
        if not isinstance(app, dict):
            continue
        if app.get("agent"):
            pinned_agent = True
            items.append({"kind": "agent", "name": app.get("name") or "Claude", "w": DOCK_WS, "big": True,
                          "windows": dock.windows(claude_rx)})
            continue
        wins = dock.windows(app.get("match"))
        claimed.update(c["class"] for c in wins)
        items.append({"kind": "app", "name": app.get("name") or "app", "w": DOCK_WS, "big": True,
                      "glyph": app.get("icon"), "color": color_of(app.get("color")),
                      "entry": ICONS.entry(desktop=app["desktop"]) if app.get("desktop") else
                      ICONS.entry(cls=wins[0]["class"]) if wins else None,
                      "launch": app.get("launch"), "windows": wins})
    opened = []
    if d.get("agent", True) and not pinned_agent and \
            ((agent.get("count") or 0) or dock.windows(claude_rx)):
        opened.append({"kind": "agent", "name": "Claude", "w": DOCK_CELL, "open": True,
                       "windows": dock.windows(claude_rx)})
    for cls in dock.order:                          # in the order they opened, as the Mac's
        if cls in claimed or cls.startswith(prefix) or cls.startswith("org.omarchy.screensaver"):
            continue
        wins = dock.windows(f"^{re.escape(cls)}$")
        if not wins:
            continue
        glyph, color = None, TEXT
        hay = f"{cls} {wins[0].get('initialTitle', '')}".lower()
        for rx, g, col in KNOWN_APPS:
            if re.search(rx, hay):
                glyph, color = g, col
                break
        entry = ICONS.entry(cls=cls)
        name = entry.get("Name") if entry and entry.get("Name") else app_name(cls, wins[0].get("title", ""))
        opened.append({"kind": "app", "name": name, "w": DOCK_CELL, "entry": entry, "glyph": glyph,
                       "color": color, "letter": name[:1].upper(), "launch": None, "windows": wins,
                       "open": True})
    if opened:
        items.append({"kind": "rule", "w": DOCK_RULE})
        items.extend(opened)
    if d.get("workspaces", True):
        ids = sorted({1, 2, 3, 4, 5} | {i for i, n in dock.workspaces.items()
                                         if isinstance(i, int) and 0 < i <= 10 and n})
        items.append({"kind": "rule", "w": DOCK_RULE})
        items.extend({"kind": "ws", "id": i, "w": DOCK_WS, "windows_n": dock.workspaces.get(i, 0),
                      "focused": i == dock.active_ws,
                      "name": f"workspace {i} · " + {0: "empty", 1: "1 window"}.get(
                          dock.workspaces.get(i, 0), f"{dock.workspaces.get(i, 0)} windows")}
                     for i in ids)
    return items


def app_name(cls, title):
    """A short name for a window class: chrome-app.hey.com__-Default -> Hey, a.b.Moonlight ->
    Moonlight."""
    m = re.match(r"(?:chrome|brave|msedge)-(?:app\.)?([^_]+)__", cls)
    if m:
        host = m.group(1).removeprefix("www.").removeprefix("web.").removeprefix("app.")
        return host.split(".")[0].capitalize()
    return cls.rsplit(".", 1)[-1].replace("-", " ").replace("_", " ").title() or title[:12]


def claude_mark(p, cx, cy, r, color):
    """Claude's spark drawn by hand: twelve tapered rays of two lengths around a small hub."""
    cr = p.cr
    cr.save()
    cr.translate(cx, cy)
    cr.set_source_rgb(*color)
    for k in range(12):
        a = k * math.pi / 6 + 0.13
        length = r * (1.0 if k % 2 == 0 else 0.78)
        half = 0.30
        cr.move_to(math.cos(a - half) * r * 0.26, math.sin(a - half) * r * 0.26)
        cr.line_to(math.cos(a - 0.05) * length, math.sin(a - 0.05) * length)
        cr.line_to(math.cos(a + 0.05) * length, math.sin(a + 0.05) * length)
        cr.line_to(math.cos(a + half) * r * 0.26, math.sin(a + half) * r * 0.26)
        cr.close_path()
    cr.fill()
    cr.arc(0, 0, r * 0.3, 0, 2 * math.pi)
    cr.fill()
    cr.restore()


def round_rect(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
    cr.close_path()


def workspace_screen(p, c, cy, n, state):
    """A workspace as a small 16:10 screen cut into one cell per window (the count square's
    grammar): 1-3 side by side, then two rows (4 = 2 x 2, 5 = 2 over 3), at most 6. Whites only:
    focused strong, used soft, empty a faint outline (Loewy L-023)."""
    cr, fw, fh = p.cr, 44, 28
    x0, y0 = c - fw / 2, cy - fh / 2
    color, lw = {"focused": (STRONG, 2.0), "used": (SOFT, 1.5)}.get(state, (DIM, 1.5))
    round_rect(cr, x0, y0, fw, fh, 4)
    cr.set_line_width(lw)
    cr.set_source_rgba(*color, 0.5 if state == "empty" else 1.0)
    cr.stroke()
    n = min(n, 6)
    if n <= 0:
        return
    gap, ix, iy, iw, ih = 2, x0 + 4, y0 + 4, fw - 8, fh - 8
    rows = 1 if n <= 3 else 2
    base, extra = divmod(n, rows)
    rh = (ih + gap) / rows
    for r in range(rows):
        cells = base + (1 if r >= rows - extra else 0)
        cw = (iw + gap) / cells
        for k in range(cells):
            cr.rectangle(ix + k * cw, iy + r * rh, cw - gap, rh - gap)
    cr.set_source_rgb(*color)
    cr.fill()


def zone_dock(p, x, w, mid, model):
    dock = model.get("dock")
    if dock is None:
        return
    a = model["agent_status"]
    items = dock_items(dock, a)
    room = w - 2 * DOCK_PAD
    while sum(i["w"] for i in items) > room:        # too many open apps: fold the last ones
        idx = max((n for n, i in enumerate(items) if i.get("open") and not i.get("more")), default=None)
        if idx is None:
            break
        more = next((i for i in items if i.get("more")), None)
        if more is None:
            more = {"kind": "app", "name": "more", "w": DOCK_CELL, "color": DIM, "letter": "+",
                    "launch": None, "windows": [], "more": 0, "open": True}
            items.insert(idx + 1, more)
        more["more"] += 1
        more["name"] = f"{more['more']} more open"
        items.pop(idx)
    total = sum(i["w"] for i in items) + 2 * DOCK_PAD
    sx = x + max(0, (w - total) / 2)                # centred in its zone, as the Mac's
    p.plate(sx, total, PLATE_DIAL, r=12)
    cx, hover, h, cr = sx + DOCK_PAD, model.get("dock_hover"), p.h, p.cr
    for it in items:                                # lay out first: where the finger is decides
        it["x"], cx = cx, cx + it["w"]
    model["dock_items"] = []
    over_ws = hover is not None and any(i["kind"] == "ws" and i["x"] <= hover < i["x"] + i["w"]
                                        for i in items)
    for n, it in enumerate(items):
        cx = it["x"]
        c = cx + it["w"] / 2
        model["dock_items"].append(it)
        if it["kind"] == "rule":
            cr.rectangle(c, 12, 1, h - 24)
            cr.set_source_rgb(0.30, 0.30, 0.32)
            cr.fill()
            cx += it["w"]
            continue
        model["touch"].append((cx, it["w"], ("dock", n), f"dock{n}"))
        under = hover is not None and cx <= hover < cx + it["w"]
        if it["kind"] == "ws":
            # the lighter plate: under the finger while it slides over them, else the focused one
            if (under if over_ws else it["focused"]):
                round_rect(cr, c - 26, mid - 2 - 25, 52, 50, 10)
                cr.set_source_rgb(*PLATE)
                cr.fill()
            workspace_screen(p, c, mid - 2, it["windows_n"],
                             "focused" if it["focused"] else "used" if it["windows_n"] else "empty")
            cx += it["w"]
            continue
        s = 1.0
        if hover is not None and not over_ws:       # the fisheye: 1.5 cells either side
            s = 1 + DOCK_MAG * max(0.0, 1 - abs(c - hover) / (1.5 * DOCK_CELL))
            if it.get("big"):                       # already big: grow less, stay inside 60 px
                s = 1 + (s - 1) * 0.35
        iy = 28 + (s - 1) * 40 if it.get("big") else 27 + (s - 1) * 14   # make room for the name
        wins = it.get("windows") or []
        front = any(win.get("address") == dock.focus for win in wins)
        if front:                                   # the app in front: a lighter plate
            pw, ph = (52, 50) if it.get("big") else (46, 46)    # big = the workspaces' plate
            pw, ph = pw + (s - 1) * 16, ph + (s - 1) * 16
            round_rect(cr, c - pw / 2, iy - ph / 2, pw, ph, 10)
            cr.set_source_rgb(*PLATE)
            cr.fill()
        size = (DOCK_BIG if it.get("big") else DOCK_ICON) * s
        if it["kind"] == "logo":
            p.icon(c, iy, OMARCHY_LOGO, size=size * 0.84, color=TEXT, font=OMARCHY_FONT)
        elif it["kind"] == "agent":
            claude_mark(p, c, iy, size * 0.48, CLAUDE_CLAY)
            state, count = a.get("state"), a.get("count") or 0
            if count:                               # the badge: one cell per session, by state
                col = {"waiting": BLUE, "working": GREEN, "idle": AMBER}.get(state, DIM)
                if state == "working" and int(time.time() * 2) % 2:
                    col = tuple(v * 0.7 for v in col)
                bs = 15
                bx, by = c + size * 0.22, iy - size * 0.55
                cr.rectangle(bx - 2, by - 2, bs + 4, bs + 4)
                cr.set_source_rgb(*(PLATE if front else PLATE_DIAL))
                cr.fill()
                count_square(p, bx, by + bs / 2, count, col, size=bs, line=1.5)
            if count:
                wins = wins or [{}]                 # sessions running: a dot, window or not
        elif ICONS.draw(p, it.get("entry"), c, iy, size):
            pass                                    # its own icon
        elif it.get("glyph"):
            p.icon(c, iy, it["glyph"], size=size * 0.85, color=it["color"])
        else:                                       # no icon at all: a letter tile
            t = size * 0.85
            round_rect(cr, c - t / 2, iy - t / 2, t, t, 6)
            cr.set_source_rgb(*PLATE)
            cr.fill()
            p.text(c - t / 2, iy, it.get("letter") or "?", size=t * 0.62, weight="Bold", font=MONO,
                   color=it.get("color", TEXT), width=t, align="center")
        if wins:                                    # running: the small white dot
            p.dot(c, h - 4.5, 2.3, TEXT)
        cx += it["w"]
    # The name of what is under the finger, above it (the Mac's tooltip)
    it = dock_hit(model, hover)
    if it:
        name = it["name"]
        if it["kind"] == "agent" and a.get("task"):
            name = f"{name} · {a['task']}"
        lw = min(260, 7 * len(name) + 12)           # about the name's width, so it centres on its item
        lx = min(max(x, it["x"] + it["w"] / 2 - lw / 2), x + w - lw)
        p.text(lx, 6, name, size=11, color=TEXT, width=lw, align="center")


def dock_hit(model, x):
    if x is None:
        return None
    return next((i for i in model.get("dock_items") or []
                 if i["kind"] != "rule" and i["x"] <= x < i["x"] + i["w"]), None)


def dock_tap(model, it):
    """Release on an item: the Omarchy menu; an app to the front (the next of its windows when it
    is already there) or launched; a workspace; the agent's window."""
    if it is None:
        return
    dock = model["dock"]
    if it["kind"] == "logo":
        cmd = (CFG["dock"].get("logo") or {}).get("tap")
        if cmd:
            run_control(["sh", "-c", cmd])
    elif it["kind"] == "ws":
        i = it["id"]
        hypr_dispatch(f'hl.dsp.focus({{ workspace = "{i}" }})', f"workspace {i}")
    elif it["kind"] == "agent":
        open_agent()
    elif it["kind"] == "app":
        wins = it.get("windows") or []
        if wins:
            front = wins[0].get("address") == dock.focus
            target = wins[-1] if front and len(wins) > 1 else wins[0]   # cycle when in front
            addr = target["address"]
            hypr_dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})', f"focuswindow address:{addr}")
        elif it.get("launch"):
            run_control(["sh", "-c", it["launch"]])
    threading.Timer(0.3, dock.refresh).start()


def dock_hold(model, it):
    """A hold: a new window of a pinned app, a new agent session, the logo's second menu, or the
    window in front moved to that workspace (silently, as Omarchy's SUPER+SHIFT+ALT+n)."""
    if it is None:
        return
    if it["kind"] == "logo":
        cmd = (CFG["dock"].get("logo") or {}).get("hold")
        if cmd:
            run_control(["sh", "-c", cmd])
    elif it["kind"] == "ws":
        i = it["id"]
        hypr_dispatch(f'hl.dsp.window.move({{ workspace = "{i}", follow = false }})',
                      f"movetoworkspacesilent {i}")
        threading.Timer(0.3, model["dock"].refresh).start()
    elif it["kind"] == "app" and it.get("launch"):
        run_control(["sh", "-c", it["launch"]])
    elif it["kind"] == "agent":
        where = os.path.expanduser(CFG["agent"].get("projects") or "~")
        cmd = ["bash", "-lc", f"cd {shlex.quote(where)} && exec claude"]
        new = shutil.which("omarchy-launch-tui", path=desktop_env().get("PATH"))   # never focuses
        run_control([new, f"--app-id={app_id('claude')}"] + cmd if new else launch_tui(app_id("claude"), cmd))


ZONE_DRAW = {"clock": zone_clock, "agent": zone_agent, "progress": zone_progress,
             "machine": zone_machine, "dock": zone_dock}
ZONE_WIDTH = {"clock": 228, "agent": None, "progress": 270, "machine": 532, "dock": None}   # None = flexible


def active_zones():
    """The configured zones, with the progress zone after the agent's when agent.progress."""
    zones = list(CFG["zones"])
    if CFG["agent"].get("progress") and "agent" in zones and "progress" not in zones:
        zones.insert(zones.index("agent") + 1, "progress")
    return zones


def controls_w():
    return 3 * DIAL_W + 3 * DIAL_GAP + (MUTE_W if CFG["lock"].get("key", True) else 0)


def render(p, model, pressed):
    """Draw one frame; returns the list of (x, w, action) touch targets. While the unlock plays,
    the sign decodes into a green UNLOCKED; then the strip."""
    now, t0 = time.time(), model.get("unlock_t0")
    rt = model.get("refresh_t0")
    model["fan_icon"] = model["battery_icon"] = None   # a sign covers the bar: no animated icons on it
    matrix = CFG["lock"].get("screen_sign") == "matrix"
    if rt and now - rt < REFRESH_S and not model.get("locked") and CFG.get("refresh_sign"):
        # the screen's rain pass just ended (its red column left the screen): the same kind of
        # sign as LOCKED: red PROCESSING decoding, then a green REFRESHED
        p.cr.identity_matrix()
        p.clear()
        p.cr.translate(*orbit(now))
        kx = p.w - MUTE_W
        if now - rt < REFRESH_PROC:
            p.sign(0, kx - GAP, "PROCESSING", RED, now - rt, 0, icon=ICON_REFRESH)
        else:
            p.sign(0, kx - GAP, "REFRESHED", GREEN, now - rt - REFRESH_PROC, 0, icon=ICON_REFRESH)
        p.plate(kx, MUTE_W, PLATE_DIAL, r=12)
        p.icon(kx + MUTE_W / 2, p.h / 2, ICON_LOCK, size=26, color=LOCKY)
        return []
    if not t0 or now >= model.get("lock_ok_until", 0) or not matrix:
        model.pop("unlock_t0", None)
        return render_frame(p, model, pressed)
    p.cr.identity_matrix()
    p.clear()
    p.cr.translate(*orbit(now))
    kx = p.w - MUTE_W
    p.sign(0, kx - GAP, "UNLOCKED", GREEN, now - t0, 0)
    p.plate(kx, MUTE_W, GREEN, r=12)                    # the key stays green to the end
    p.icon(kx + MUTE_W / 2, p.h / 2, ICON_FINGER, size=26, color=BG)
    return []


def render_frame(p, model, pressed):
    """Draw one frame; returns the list of (x, w, action) touch targets."""
    model["fan_icon"] = model["battery_icon"] = None
    model["touch"] = []                         # zones add (x, w, action, name) tap areas
    p.cr.identity_matrix()
    p.clear()
    if model.get("dark") and not model.get("touch_id"):   # main screen off: keep the OLED dark
        return []
    # OLED burn-in: the whole picture drifts a pixel or two every ORBIT_EVERY seconds; touch
    # targets stay where they are (a 2 px offset is far below a finger)
    p.cr.translate(*orbit())
    w, mid = p.w, p.h / 2
    targets = []
    overlay = model.get("touch_id")

    if model.get("locked"):
        # The lock screen: a black bar with LOCKED in red in the middle, decoding out of red
        # katakana as the screen's red column did, and the key at the right end next to the
        # sensor: an amber key with a black fingerprint; red on a miss, a green key once recognised. No Esc and no text: nothing to back out
        # of here, and typing the password still works.
        state, now = (overlay or ("authenticate", None))[0], time.time()
        kx = w - MUTE_W
        if model.get("lock_view") is None:
            model["lock_view"] = True
            model["lock_since"] = now
        model["lock_step"] = now
        if CFG["lock"].get("screen_sign") == "matrix":      # "off": the key alone
            p.sign(0, kx - GAP, "LOCKED", RED, now - model["lock_since"], now - model["lock_since"])
        if state == "retry":
            icon, color = ICON_FINGER, RED
        elif state == "success":
            icon, color = ICON_FINGER, GREEN
            if not model.get("unlock_t0") and CFG["lock"].get("screen_sign") == "matrix":   # the unlock plays
                model["unlock_t0"], model["lock_ok_until"] = now, now + UNLOCK_S
        else:
            icon, color = ICON_FINGER, LOCKY                # the amber fingerprint key, no arrow
        if color == GREEN:                              # recognised: green key, black icon
            p.plate(kx, MUTE_W, GREEN, r=12)
            p.icon(kx + MUTE_W / 2, mid, icon, size=26, color=BG)
        elif color == LOCKY:                            # amber key, black icon
            p.plate(kx, MUTE_W, LOCKY, r=12)
            p.icon(kx + MUTE_W / 2, mid, icon, size=26, color=BG)
        else:
            p.plate(kx, MUTE_W, PLATE_DIAL, r=12)
            p.icon(kx + MUTE_W / 2, mid, icon, size=26, color=color)
        return targets

    model["lock_view"] = None                   # a fresh sign and fingerprint for the next lock
    if model.get("fn"):
        for i, (x, sw) in enumerate(slot_rects(w)):
            name = "esc" if i == 0 else f"F{i}"
            p.plate(x, sw, PRESSED if name in pressed else PLATE)
            p.text(x, mid, name, width=sw, align="center")
            targets.append((x, sw, ("key", KEY_ESC if i == 0 else KEY_F[i - 1]), name))
        return targets

    # Esc
    p.esc_key("esc" in pressed)
    targets.append((0, ESC_W, ("key", KEY_ESC), "esc"))
    controls_x = w - controls_w()

    # Status zones in the configured order, between Esc and the controls. Fixed zones keep their
    # width; the agent takes what is left.
    zones = active_zones()
    x, end = ESC_W + 24, controls_x - 16
    fixed = sum(ZONE_WIDTH[z] for z in zones if ZONE_WIDTH[z]) + 24 * (len(zones) - 1)
    flex = max(260, end - x - fixed)
    for i, zone in enumerate(zones):
        zw = ZONE_WIDTH[zone] or flex
        if x + zw > end:
            break                                   # never draw over the controls
        ZONE_DRAW[zone](p, x, zw, mid, model)
        x += zw
        if i < len(zones) - 1:
            x = divider(p, x)

    targets.extend(model["touch"])

    # Controls: screen brightness, keyboard backlight, volume as ring dials, then mute
    levels, x, active = model["machine"].levels, controls_x, model.get("active_dial")
    cr = p.cr
    for key, icon, color in DIALS:
        on = key == active
        p.plate(x, DIAL_W, PLATE if on else PLATE_DIAL, r=12)     # white and greys only
        cx, level = x + DIAL_W / 2, levels.get(key)
        hint = model["machine"].hints.get(key) if key != "vol" else \
            (model["ambient"].hint() if model.get("ambient") else None)
        # Smooth ring in the clock's white on dark grey: arc, knob, icon and glow; no colour
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(5)
        muted = key == "vol" and levels.get("muted")
        off = muted or (level is not None and level <= 0.005)
        cr.arc(cx, mid, 22, 0.75 * math.pi, 2.25 * math.pi)
        cr.set_source_rgba(*(RED if off else TEXT), 0.45 if off else 0.14)
        cr.stroke()
        # Where a gesture left it, in whites only: red off / muted, strong white at max, plain
        # white at the suggestion; anywhere else the soft/full white arcs below
        state = None if off or level is None else STRONG if level >= 0.995 else \
            TEXT if hint is not None and abs(level - hint) < 0.02 else None
        if muted:
            pass
        elif state and level is not None:
            end = 0.75 * math.pi + 1.5 * math.pi * level
            if on:
                cr.set_line_width(11)
                cr.arc(cx, mid, 22, 0.75 * math.pi, end)
                cr.set_source_rgba(*state, 0.3)
                cr.stroke()
                cr.set_line_width(5)
            if state == STRONG:                         # a soft halo marks max
                cr.set_line_width(9)
                cr.arc(cx, mid, 22, 0.75 * math.pi, end)
                cr.set_source_rgba(*STRONG, 0.18)
                cr.stroke()
                cr.set_line_width(5)
            cr.arc(cx, mid, 22, 0.75 * math.pi, end)
            cr.set_source_rgb(*state)
            cr.stroke()
            cr.arc(cx + 22 * math.cos(end), mid + 22 * math.sin(end), 4.5 if on else 3.5, 0, 2 * math.pi)
            cr.fill()
        elif level is not None:
            end = 0.75 * math.pi + 1.5 * math.pi * level
            if on:                                      # glow while touched
                cr.set_line_width(11)
                cr.arc(cx, mid, 22, 0.75 * math.pi, end)
                cr.set_source_rgba(*TEXT, 0.25)
                cr.stroke()
                cr.set_line_width(5)
            if level > 0:
                # Up to the hint the arc is a softer white; past it, full white: how far above
                # the suggested level you are. With no hint, all full white.
                split = end if hint is None else min(end, 0.75 * math.pi + 1.5 * math.pi * hint)
                cr.arc(cx, mid, 22, 0.75 * math.pi, split)
                cr.set_source_rgb(*(SOFT if hint is not None else TEXT))
                cr.stroke()
                if split < end:
                    cr.arc(cx, mid, 22, split, end)
                    cr.set_source_rgb(1, 1, 1)
                    cr.stroke()
            cr.arc(cx + 22 * math.cos(end), mid + 22 * math.sin(end), 4.5 if on else 3.5, 0, 2 * math.pi)
            cr.set_source_rgb(*TEXT)
            cr.fill()
        if hint is not None and not off:                # what the room's light suggests: a quiet dot
            a = 0.75 * math.pi + 1.5 * math.pi * hint
            hx, hy = cx + 22 * math.cos(a), mid + 22 * math.sin(a)
            cr.arc(hx, hy, 4.2, 0, 2 * math.pi)        # a black ring, so it shows even on the knob
            cr.set_source_rgb(*BG)
            cr.fill()
            cr.arc(hx, hy, 2.8, 0, 2 * math.pi)
            cr.set_source_rgb(*HINT_DOT)
            cr.fill()
        cr.set_line_cap(cairo.LINE_CAP_BUTT)
        if on and level is not None:                    # the number while touched
            p.text(cx - 30, mid, f"{round(level * 100)}", size=16, weight="Bold", font=MONO,
                   width=60, align="center")
        else:
            p.icon(cx, mid, "\U000f0581" if muted else icon, size=20, color=RED if off else TEXT)
        targets.append((x, DIAL_W, ("dial", key, x, DIAL_W), key))
        x += DIAL_W + DIAL_GAP
    # lock while open; a fingerprint while a Touch ID request runs (sudo, an approval): an amber
    # key with a black fingerprint; red on a miss, green on success. lock.key = false: no key.
    if not CFG["lock"].get("key", True):
        return targets
    tid = model.get("touch_id")
    locked = model.get("locked") or tid
    state = tid[0] if tid else ""
    if locked and state == "success":                   # green key, black fingerprint
        p.plate(x, MUTE_W, GREEN, r=12)
        p.icon(x + MUTE_W / 2, mid, ICON_FINGER, size=26, color=BG)
    elif locked and state == "retry":
        p.plate(x, MUTE_W, PLATE_DIAL, r=12)
        p.icon(x + MUTE_W / 2, mid, ICON_FINGER, size=26, color=RED)
    elif locked:
        if int((time.time() - model.get("tid_since", 0)) / SUDO_BLINK) == 1:    # the one blink
            p.plate(x, MUTE_W, PLATE_DIAL, r=12)
        else:
            p.plate(x, MUTE_W, LOCKY, r=12)
            p.icon(x + MUTE_W / 2, mid, ICON_FINGER, size=26, color=BG)
    else:
        p.plate(x, MUTE_W, (1.0, 0.88, 0.50) if "lock" in pressed else LOCKY, r=12)   # amber key, black lock
        p.icon(x + MUTE_W / 2, mid, ICON_LOCK, size=26, color=BG)
    targets.append((x, MUTE_W, ("finger",) if locked else ("slot", "lock"), "lock"))
    return targets


def divider(p, x):
    p.cr.rectangle(x, 14, 1, p.h - 28)
    p.cr.set_source_rgb(0.25, 0.25, 0.27)
    p.cr.fill()
    return x + 24


# --- hardware session ------------------------------------------------------------------------
class Bar:
    def __init__(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        self.sock.connect(SOCKET_PATH)
        self.next_id = 1
        self.frame_id = 0
        self.busy = False

    def send(self, mtype, payload=b"", fds=None):
        rid = self.next_id
        self.next_id = self.next_id % 0xFFFFFFFF + 1
        packet = HEADER.pack(MAGIC, MAJOR, mtype, len(payload), rid) + payload
        if fds:
            self.sock.sendmsg([packet], [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                                          array.array("i", fds))])
        else:
            self.sock.send(packet)
        return rid

    def recv(self):
        data = self.sock.recv(65536)
        if not data:
            raise ConnectionError("service closed the connection")
        magic, major, mtype, length, rid = HEADER.unpack_from(data)
        if magic != MAGIC or major != MAJOR or len(data) != HEADER.size + length:
            raise ConnectionError("malformed packet")
        return mtype, rid, data[HEADER.size:]

    def handshake(self):
        self.send(HELLO, struct.pack("<HHQ", MINOR, 0, FEATURES))
        mtype, _, payload = self.recv()
        if mtype != HELLO_ACK:
            raise ConnectionError(f"hello refused: type {mtype:#x} {payload.hex()}")
        _, _, w, h, fmt, _ = struct.unpack("<HHIIII", payload)
        if fmt != 1:
            raise ConnectionError(f"unexpected pixel format {fmt}")
        self.w, self.h, self.stride = w, h, w * 4
        size = self.stride * h
        fd = os.memfd_create("t1-frame", os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
        os.ftruncate(fd, size)
        self.mem = mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE)
        fcntl.fcntl(fd, fcntl.F_ADD_SEALS,
                    fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_GROW | fcntl.F_SEAL_SEAL)
        self.send(REGISTER, struct.pack("<IIQ", BUFFER_ID, self.stride, size), fds=[fd])
        os.close(fd)
        mtype, _, payload = self.recv()
        if mtype != ACK:
            raise ConnectionError(f"buffer refused: {payload.hex()}")
        log(f"connected, {w}x{h}")

    def submit(self, surface):
        surface.flush()
        self.mem[:] = bytes(surface.get_data())
        self.frame_id += 1
        self.send(SUBMIT, struct.pack("<IQI", BUFFER_ID, self.frame_id, 0))
        self.busy = True

    def tap(self, key):
        self.send(TAP, struct.pack("<B3x4H", 1, key, 0, 0, 0))


INPUT_HEAD = struct.Struct("<QBBH")      # monotonic_ns, fn_pressed, contact_count, reserved
CONTACT = struct.Struct("<BBBBII")       # id, tip, in_range, reserved, x, y


def parse_input(payload):
    """InputFrame -> (fn held, {contact id: x} for contacts touching the glass)."""
    _, fn, count, _ = INPUT_HEAD.unpack_from(payload)
    contacts = {}
    for i in range(count):
        cid, tip, _, _, x, _ = CONTACT.unpack_from(payload, INPUT_HEAD.size + CONTACT.size * i)
        if tip:
            contacts[cid] = x
    return bool(fn), contacts


def run():
    bar = Bar()
    bar.handshake()
    painter = Painter(bar.w, bar.h)
    load_config()
    machine, agent = Machine(), Agent()
    model = {"machine": machine, "agent": agent, "agent_status": agent.status(), "fn": False,
             "touch_id": None, "ambient": Ambient(), "dock": Dock()}
    contacts, held, pressed, targets, docked = {}, {}, set(), [], {}
    dirty, next_sample, last_second, last_spin = True, 0.0, -1, time.time()
    spin, base = False, cairo.ImageSurface(cairo.FORMAT_RGB24, painter.w, painter.h)
    last_dial, next_lock, dials, last_tap = 0.0, 0.0, {}, (None, 0.0)
    last_refresh = time.time()
    try:
        if helper("hw") and any(f.read_text().strip() == "1"
               for f in Path("/sys/devices/platform/applesmc.768").glob("fan*_manual")):
            root_hw("fan-auto")                 # a previous run left max fans on
    except OSError:
        pass
    sel = selectors.DefaultSelector()
    sel.register(bar.sock, selectors.EVENT_READ)

    while True:
        now = time.time()
        if now >= next_sample:
            load_config()
            sync_wall_bar()
            machine.sample()
            agent.sample()
            model["agent_status"] = agent.status()
            model["dock"].ensure()
            next_sample, dirty = now + (10 if model.get("dark") else 2), True   # idle while dark
        if model["dock"].version != model.get("dock_seen"):     # a window opened, closed, moved
            model["dock_seen"], dirty = model["dock"].version, True
        t = machine.temp() if model.get("boost") or model.get("fan_boost") else None
        if model.get("boost") and t is not None and t >= BOOST_HOT:     # too hot: boost off
            model["boost"] = False
            set_profile("balanced")
            model["slot_flash"], dirty = ("cpu", "boost off: hot", now + 4), True
        fb = model.get("fan_boost")
        if fb and now >= fb[0] and (t is not None and t <= FAN_GOOD or now >= fb[1]):
            model["fan_boost"] = None                                   # cooled down: SMC again
            root_hw("fan-auto")
            model["slot_flash"], dirty = ("thermal", "fan auto", now + 3), True
        if model.get("relevel") and now >= model["relevel"]:    # show a dial's new level fast
            machine.read_levels()
            model["relevel"], dirty = None, True
        if now >= next_lock:
            locked, next_lock = session_locked(), now + (0.25 if model["touch_id"] else 1)
            if locked is None:                          # unreadable: keep what was shown
                locked = model.get("locked", False)
            if locked != model.get("locked"):
                model["locked"], dirty = locked, True
        try:                                            # a screen rain pass ended
            rm = os.stat(refresh_signal()).st_mtime if CFG.get("refresh_sign") else 0
        except OSError:
            rm = 0
        if rm > last_refresh:
            if now - rm < 3:
                model["refresh_t0"], dirty = now, True
            last_refresh = rm
        if model.get("refresh_t0") and now - model["refresh_t0"] < REFRESH_S + 0.2:
            dirty = True                                # the sign decodes at the loop's pace
        overlay = touch_id_overlay()
        if overlay and not model["touch_id"]:
            model["tid_since"] = now                    # the sudo key's one blink starts
        if now - model.get("tid_since", 0) < 2 * SUDO_BLINK + 0.1:
            dirty = True
        if overlay and not model["touch_id"]:           # a verify starting: is it the lock screen?
            model["locked"], next_lock = session_locked(), now + 0.25
        if overlay != model["touch_id"]:
            model["touch_id"], dirty = overlay, True
        lock_view = bool(model.get("locked") and (model["touch_id"] or not model.get("dark"))) or \
            model.get("lock_ok_until", 0) > now - 0.3
        anim = model.get("lock_ok_until", 0) > now
        decoding = anim or (model.get("locked") and now - model.get("lock_since", 0) < 1.2)
        if lock_view and now - model.get("lock_step", 0) >= (1 / 30 if decoding else 1):   # decode 30 fps, still 1
            dirty = True                                # lock screen sign and key
        elif agent.busy and int(now * 2) != last_second:     # pulse the working square
            last_second, dirty = int(now * 2), True
        if now - last_spin >= 1 / SPIN_FPS:                 # turn the fan icon with the fans
            if machine.fan_pct:                         # 0.25 turns/s at min RPM, 2 at max
                model["fan_angle"] = (model.get("fan_angle", 0.0) + (now - last_spin) * 2 * math.pi
                                      * (0.25 + 1.75 * machine.fan_frac)) % (2 * math.pi)
                spin = True
            if machine.charging:
                spin = True
            last_spin = now

        dark = CFG["oled_care"].get("dark_on_dpms", True) and screen_off() \
            and now >= model.get("wake_until", 0)
        if dark != model.get("dark", False):
            model["dark"], dirty = dark, True
        if dirty and not bar.busy:
            model["defer_anim"] = True                # full frame without the fan, kept as base
            targets = render(painter, model, pressed)
            model["defer_anim"] = False
            painter.surface.flush()
            base.get_data()[:] = painter.surface.get_data()
            draw_anim(painter, model)
            bar.submit(painter.surface)
            dirty = spin = False
        elif spin and not bar.busy and model.get("fan_icon"):
            painter.surface.get_data()[:] = base.get_data()
            painter.surface.mark_dirty()
            draw_anim(painter, model)
            bar.submit(painter.surface)
            spin = False

        if model.get("refresh_t0") and now - model["refresh_t0"] < REFRESH_S + 0.2 and not held:
            timeout = 0.033
        elif now - model.get("tid_since", 0) < 2 * SUDO_BLINK + 0.1 and not held:
            timeout = 0.1                               # the sudo key's blink
        elif lock_view and not held:
            timeout = 0.033 if model.get("lock_ok_until", 0) > now or \
                now - model.get("lock_since", 0) < 1.2 else 0.5
        elif model.get("dark") and not held:         # panel off: wake twice a second, for touches
            timeout = 0.5
        else:
            timeout = 0.03 if held else \
                1 / SPIN_FPS if machine.fan_pct or machine.charging else 0.2
        for _ in sel.select(timeout=timeout):
            mtype, rid, payload = bar.recv()
            if mtype == FRAME_RELEASED:
                if bar.frame_id == 1:
                    log("first frame presented")
                bar.busy = False
            elif mtype == ERROR:
                code = struct.unpack("<I", payload)[0]
                log(f"request {rid} refused, error {code}")
                if code in (4, 5):          # invalid / unknown buffer: give up, fall back
                    return 1
            elif mtype == INPUT_FRAME:
                try:
                    fn, now_contacts = parse_input(payload)
                except struct.error:
                    log(f"skipped a malformed input frame ({len(payload)} bytes)")
                    continue
                if fn != model["fn"]:
                    model["fn"], dirty = fn, True
                for cid, x in now_contacts.items():
                    if cid in contacts:
                        continue
                    if model.get("dark"):            # same while the main screen is off
                        model["wake_until"], model["dark"], dirty = time.time() + 15, False, True
                        continue
                    if not may_act():                # locked, or the lock state is unknown
                        continue
                    for tx, tw, action, name in targets:   # fire on touch-down, like stock
                        if tx <= x < tx + tw:
                            if action[0] == "key":
                                bar.tap(action[1])
                            elif action[0] == "control":
                                run_control(action[1])
                                model["relevel"] = time.time() + 0.25
                            elif action[0] == "open":       # tap opens, tap again closes
                                if not (len(action) > 2 and close_window(action[2])):
                                    run_control(action[1])
                            elif action[0] == "agent":
                                open_agent()
                            elif action[0] == "slot":
                                due = time.time() + REPEAT_DELAY    # tap or hold: decided below
                                if slot_action(action[1], "hold") is None and action[1] != "lock":
                                    msg = run_action(model, slot_action(action[1], "tap"),
                                                     time.time(), action[1])   # no hold: at once
                                    if msg:
                                        model["slot_flash"] = (action[1], msg, time.time() + 3)
                                    due = 0
                                held[cid] = (name, action, due)
                                pressed.add(name)
                                dirty = True
                                break
                            elif action[0] == "dock":           # magnify now, act on release
                                docked[cid] = {"x0": x, "x": x, "t0": time.time(), "slide": False,
                                               "fired": False}
                                model["dock_hover"] = x
                            elif action[0] == "finger":         # the sensor is the input: nothing
                                pass
                            elif action[0] == "dial":           # tap, double tap, hold or slide
                                dials[cid] = {"x0": x, "t0": time.time(), "slide": False}
                                model["active_dial"] = action[1]
                            held[cid] = (name, action, time.time() + REPEAT_DELAY)
                            pressed.add(name)
                            dirty = True
                            break
                for cid, x in now_contacts.items():     # a finger sliding along the dock
                    d = docked.get(cid)
                    if d and x != d["x"]:
                        d["x"], model["dock_hover"], dirty = x, x, True
                        d["slide"] = d["slide"] or abs(x - d["x0"]) > DIAL_MOVE
                for cid, x in now_contacts.items():     # a finger sliding on a dial
                    action = held.get(cid, (None, (None,)))[1]
                    d = dials.get(cid)
                    if d and not d["slide"] and d.get("fired") is None and abs(x - d["x0"]) > DIAL_MOVE:
                        d["slide"] = True
                    if action[0] == "dial" and d and d["slide"] and x != contacts.get(cid) \
                            and time.time() - last_dial >= DIAL_EVERY and may_act():
                        set_level(machine, action[1], dial_level(action, x))
                        last_dial, dirty = time.time(), True
                for cid in set(held) - set(now_contacts):
                    name, action, due = held.pop(cid)
                    pressed.discard(name)
                    if not may_act():               # locked since the touch began
                        dials.pop(cid, None)
                        docked.pop(cid, None)
                        model["dock_hover"] = None if not docked else model.get("dock_hover")
                        dirty = True
                        continue
                    if action[0] == "dock":
                        d = docked.pop(cid, None)
                        if d and not d["fired"]:
                            dock_tap(model, dock_hit(model, d["x"]))
                        if not docked:
                            model["dock_hover"] = None
                    if action[0] == "slot" and due:             # released before the hold fired: a tap
                        msg = run_action(model, slot_action(action[1], "tap"), time.time(), action[1])
                        if msg:
                            model["slot_flash"] = (action[1], msg, time.time() + 3)
                    if action[0] == "dial":
                        d, key = dials.pop(cid, {}), action[1]
                        if d.get("slide"):
                            set_level(machine, key, dial_level(action, contacts.get(cid, 0)))
                        elif d.get("fired") is None:            # a tap
                            hint = machine.hints.get(key) if key != "vol" else \
                                (model["ambient"].hint() if model.get("ambient") else None)
                            t = time.time()
                            if key != "vol" and last_tap[0] == key and t - last_tap[1] < DOUBLE_TAP:
                                set_level(machine, key, 1.0)            # double tap: max
                                last_tap = (None, 0.0)
                            else:
                                if hint is not None:                # to the suggestion (volume: room loudness)
                                    set_level(machine, key, hint)
                                else:
                                    set_level(machine, key, dial_level(action, d.get("x0", 0)))
                                last_tap = (key, t)
                        model["active_dial"], model["relevel"] = None, time.time() + 0.4
                    dirty = True
                contacts = now_contacts

        # Hold to repeat, as Omarchy's repeating key bindings do
        now = time.time()
        for cid, (name, action, due) in list(held.items()):
            locks = action[0] == "slot" and slot_action(action[1], "hold") == "lock"
            if not locks and not may_act():             # nothing but locking runs while locked
                continue
            d = dials.get(cid)
            if action[0] == "dial" and d and not d["slide"] and d.get("fired") is None \
                    and now - d["t0"] >= CFG["dial_hold_seconds"]:
                d["fired"] = True                               # hold: off, or mute
                if action[1] == "vol":
                    run_control(CONTROLS[6][3])
                else:
                    set_level(machine, action[1], 0.0, off=True)
                model["relevel"], dirty = now + 0.3, True
                continue
            d = docked.get(cid)
            if action[0] == "dock" and d and not d["fired"] and not d["slide"] \
                    and now - d["t0"] >= CFG["hold_seconds"]:
                d["fired"], dirty = True, True                  # hold: a new window
                dock_hold(model, dock_hit(model, d["x"]))
                continue
            if action[0] == "slot" and due:
                hold = slot_action(action[1], "hold")
                wait = CFG["lock_hold_seconds"] if action[1] == "lock" else CFG["hold_seconds"]
                if hold is not None and now >= due - REPEAT_DELAY + wait:
                    message = run_action(model, hold, now, action[1])
                    if message:
                        model["slot_flash"] = (action[1], message, now + 3)
                    held[cid], dirty = (name, action, 0), True      # 0 = hold fired, no tap
                    continue
            if action[0] == "control" and action[2] and now >= due:
                run_control(action[1])
                held[cid] = (name, action, now + REPEAT_EVERY)
                model["relevel"] = now + 0.25

def preview(path):
    if cairo is None:
        sys.exit(f"touchbar-strip: --preview needs pycairo and PyGObject ({GFX_ERROR})")
    load_config()
    painter = Painter(2170, 60)
    machine, agent = Machine(), Agent()
    machine.sample()
    time.sleep(0.5)
    machine.sample()
    agent.sample()
    model = {"machine": machine, "agent": agent, "agent_status": agent.status(),
             "fn": "--fn" in sys.argv, "touch_id": None, "dock": Dock()}
    model["dock"].refresh()
    if "--zones" in sys.argv:
        CFG["zones"] = [ZONE_ALIASES.get(z, z) for z in sys.argv[sys.argv.index("--zones") + 1].split(",")]
    model["locked"] = "--locked" in sys.argv
    if "--lockage" in sys.argv:                 # a frame this many seconds into the lock
        model["lock_view"], model["lock_since"] = True, time.time() - float(sys.argv[sys.argv.index("--lockage") + 1])
    if "--refresh" in sys.argv:                 # a frame of the REFRESHED sign, this many seconds in
        CFG["refresh_sign"] = True
        model["refresh_t0"] = time.time() - float(sys.argv[sys.argv.index("--refresh") + 1])
    if "--unlock" in sys.argv:                  # a frame of the unlock, this many seconds in
        t0 = time.time() - float(sys.argv[sys.argv.index("--unlock") + 1])
        model["unlock_t0"], model["lock_ok_until"], model["lock_since"] = t0, t0 + UNLOCK_S, t0 - 5
    if "--touch-id" in sys.argv:
        model["touch_id"] = ("authenticate", None)
    if "--hover" in sys.argv:                   # a finger on the dock at this x
        render(Painter(2170, 60), model, set())     # lay the dock out once, then draw it magnified
        model["dock_hover"] = float(sys.argv[sys.argv.index("--hover") + 1])
    render(painter, model, set())
    painter.surface.write_to_png(path)


def check():
    """Print the config in use, every configured action and whether what it needs is there.
    Exit 1 when the config is refused or an action is unknown."""
    load_config(force=True)
    bad = 0
    if CONFIG.exists():
        unsafe = None
        try:
            unsafe = config_unsafe(CONFIG)
            user = json.loads(CONFIG.read_text())
            problems = validate(merged_config(user)) if isinstance(user, dict) else ["not an object"]
        except (OSError, ValueError) as e:
            problems = [str(e)]
        if unsafe:
            problems = [f"refused: {unsafe}"] + problems
        print(f"config   {CONFIG}: {'REFUSED, using the defaults: ' + '; '.join(problems) if problems else 'ok'}")
        bad += bool(problems)
    else:
        print(f"config   {CONFIG}: not there, using the defaults")
    print(f"graphics {'ok' if cairo else f'missing ({GFX_ERROR})'}")
    print(f"zones    {', '.join(active_zones())}")
    a = CFG["agent"]
    if "agent" in CFG["zones"]:
        what = a.get("command") if a.get("provider") == "command" else \
            f"transcripts in {CLAUDE_PROJECTS}" + (f", commits in {a['projects']}" if a.get("projects") else "")
        print(f"agent    provider {a.get('provider')} ({what}); tap: {a.get('open')}")
    if "dock" in CFG["zones"]:
        path = desktop_env().get("PATH")
        for app in CFG["dock"].get("pinned") or []:
            if app.get("agent"):
                print(f"dock     {app.get('name') or 'Claude':9} the agent (tap: {a.get('open')})")
                continue
            prog = (shlex.split(app.get("launch") or "") or [""])[0]
            print(f"dock     {app.get('name', '?'):9} {app.get('launch')}: "
                  f"{'ok' if shutil.which(prog, path=path) else 'NOT FOUND (tap focuses only)'}")
        print(f"dock     socket {hypr_socket('.socket2.sock') or 'no Hyprland session found'}")
    print(f"clock    {CFG['clock'].get('timezone') or 'local time'}"
          f"{', label ' + repr(CFG['clock'].get('label')) if CFG['clock'].get('label') is not None else ''}"
          f"{', hour mark ' + repr(CFG['clock'].get('hour_mark')) if CFG['clock'].get('hour_mark') else ''}")
    print(f"lock     key {'on' if CFG['lock'].get('key', True) else 'off'}, screen sign {CFG['lock'].get('screen_sign')}")
    oc = CFG["oled_care"]
    print(f"oled     orbit {'on' if oc.get('orbit') else 'off'}, dark while the screen is off "
          f"{'on' if oc.get('dark_on_dpms') else 'off'}")
    sig = refresh_signal()
    print(f"wall     hide the bar while the wall is up: {'on' if CFG.get('wall', {}).get('hide_bar') else 'off'}")
    print(f"refresh  sign {'on (' + str(sig) + ', written by omarchy-mac-kit-extras omk-rainpass)' if CFG.get('refresh_sign') else 'off'}")
    print(f"dials    hints {'on' if CFG['dials'].get('hints', True) else 'off'}, room loudness (mic) "
          f"{'on' if CFG['dials'].get('room_loudness') else 'off'}")
    needs = {"hwdeck": "hwdeck", "wall": "hwdeck", "fans-max": "hw", "mem-trim": "hw",
             "lid-mode": "lid", "lock-rain": "rainpass", "lock": "lock_cmd"}
    for slot in SLOT_NAMES:
        for kind in ("tap", "hold"):
            act = slot_action(slot, kind)
            if act is None:
                continue
            problem = action_problem(act)
            if problem:
                note, bad = f"BAD: {problem}", bad + 1
            elif act.startswith("sh:"):
                note = "shell command (runs as you)"
            elif act == "charge-limit":
                note = "ok" if os.access(CHARGE_KNOB, os.W_OK) else \
                    "needs setup: omarchy-mac-kit module 'battery-limit' (no writable charge knob)"
            elif act == "agent-open":
                note = "ok"
            else:
                key = needs.get(act.split(":")[0])
                if key is None:
                    note = "ok"
                else:
                    found = helper(key)
                    note = f"ok ({found})" if found else \
                        f"needs setup: helpers.{key} = {CFG['helpers'].get(key)!r} not found" + \
                        (f" ({NEEDS[act][1]})" if act in NEEDS else "") + \
                        (", falls back to lock" if act == "lock-rain" else "") + \
                        (", uses loginctl lock-session" if act == "lock" else "")
            print(f"slot     {slot:8} {kind:4} {act:22} {note}")
    smc = helper_file("smc_power")
    print(f"helper   smc_power {smc}: {'present' if smc and smc.exists() else 'absent (power falls back to the battery)'}")
    return 1 if bad else 0


if __name__ == "__main__":
    if "--config" in sys.argv:
        CONFIG = Path(os.path.expanduser(sys.argv[sys.argv.index("--config") + 1]))
    if "--check" in sys.argv:
        sys.exit(check())
    if len(sys.argv) > 2 and sys.argv[1] == "--preview":
        preview(sys.argv[2])
        sys.exit(0)
    if cairo is None:
        log(f"stopping: pycairo and PyGObject are needed ({GFX_ERROR})")
        sys.exit(1)
    try:
        sys.exit(run())
    except (OSError, ConnectionError) as e:
        log(f"stopping: {e}")
        sys.exit(1)
