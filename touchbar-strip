def _merge(base, over):
    out = copy.deepcopy(base)
    for k, v in over.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = _merge(out[k], v)
        else:
            out[k] = v
    return out


def _say_once(msg):
    if msg not in _cfg_said:
        _cfg_said.add(msg)
        log(msg)


def config_unsafe(path):
    """Why a config file must not be used, or None. It holds sh: commands that run as you, so
    it, and the folder it is in, must be yours and not writable by group or others."""
    uid = os.getuid()
    for f in (path, path.parent):
        st = f.stat()
        if st.st_uid != uid:
            return f"{f} is not owned by you"
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            return f"{f} is writable by group or others (chmod go-w)"
    return None


def validate(cfg):
    """Problems in a merged config, as a list of strings (empty = good)."""
    bad = []
    zones = cfg.get("zones")
    if (not isinstance(zones, list) or len(set(zones)) != len(zones)
            or not all(z in ZONE_DRAW for z in zones)):
        bad.append(f"zones must be a list from {sorted(ZONE_DRAW)}")
    for k in ("hold_seconds", "dial_hold_seconds", "lock_hold_seconds"):
        if not isinstance(cfg.get(k), (int, float)) or not 0.2 <= cfg[k] <= 5:
            bad.append(f"{k} must be a number of seconds, 0.2-5")
    if cfg["lock"].get("screen_sign") not in ("matrix", "off"):
        bad.append('lock.screen_sign must be "matrix" or "off"')
    oc = cfg.get("oled_care")
    if not isinstance(oc, dict) or not all(isinstance(oc.get(k), bool) for k in ("orbit", "dark_on_dpms")):
        bad.append("oled_care.orbit and oled_care.dark_on_dpms must be true or false")
    if not isinstance(cfg.get("refresh_sign"), bool):
        bad.append("refresh_sign must be true or false")
    if not isinstance(cfg.get("wall"), dict) or not isinstance(cfg["wall"].get("hide_bar"), bool):
        bad.append("wall.hide_bar must be true or false")
    if cfg["agent"].get("provider") not in ("claude-code", "command"):
        bad.append('agent.provider must be "claude-code" or "command"')
    if cfg["agent"].get("provider") == "command" and not cfg["agent"].get("command"):
        bad.append('agent.provider "command" needs agent.command')
    tz = cfg["clock"].get("timezone")
    if tz:
        try:
            from zoneinfo import ZoneInfo
            ZoneInfo(tz)
        except Exception:                       # noqa: BLE001 - any failure is a bad zone
            bad.append(f"clock.timezone {tz!r} is not a known time zone")
    dock = cfg.get("dock")
    if not isinstance(dock, dict) or not isinstance(dock.get("pinned"), list):
        bad.append("dock.pinned must be a list")
    else:
        for i, app in enumerate(dock["pinned"]):
            if not isinstance(app, dict) or not (app.get("agent") or app.get("launch")):
                bad.append(f"dock.pinned[{i}] needs \"launch\" (or \"agent\": true)")
                continue
            try:
                re.compile(app.get("match") or "")
            except re.error as e:
                bad.append(f"dock.pinned[{i}].match: {e}")
        if "dock" in (zones or []) and "agent" in (zones or []):
            bad.append("zones: dock and agent both take the free width; use one of them")
    for name, slot in cfg.get("slots", {}).items():
        if name not in SLOT_NAMES or not isinstance(slot, dict):
            bad.append(f"slots.{name}: unknown slot (slots are {', '.join(SLOT_NAMES)})")
    return bad


def merged_config(user):
    """The defaults with a user config laid over them (old zone names read as new ones)."""
    user = dict(user)
    if isinstance(user.get("zones"), list):
        user["zones"] = [ZONE_ALIASES.get(z, z) for z in user["zones"]]
    return _merge(DEFAULTS, user)


def load_config(force=False):
    """Re-read the config when it changed; any problem keeps the defaults (logged once)."""
    global CFG, _cfg_seen
    try:
        st = CONFIG.stat()
    except FileNotFoundError:
        if _cfg_seen != ("missing", None):
            CFG, _cfg_seen = copy.deepcopy(DEFAULTS), ("missing", None)
            apply_font()
        return CFG
    except OSError as e:
        _say_once(f"config ignored: {e}")
        return CFG
    key = (st.st_mtime, st.st_size)
    if key == _cfg_seen and not force:
        return CFG
    _cfg_seen = key
    try:
        unsafe = config_unsafe(CONFIG)
        if unsafe:
            raise ValueError(f"refused: {unsafe}")
        user = json.loads(CONFIG.read_text())
        if not isinstance(user, dict):
            raise ValueError("the top level must be an object")
        merged = merged_config(user)
        problems = validate(merged)
        if problems:
            raise ValueError("; ".join(problems))
    except (OSError, ValueError) as e:
        _say_once(f"config ignored, using the defaults: {e}")
        CFG = copy.deepcopy(DEFAULTS)
    else:
        CFG = merged
    apply_font()
    return CFG


def apply_font():
    """The icon font from the config, or a plain monospace when it is not installed (icons
    then show as boxes; numbers and text still read)."""
    global MONO
    want = CFG.get("font") or DEFAULTS["font"]
    if cairo is None:
        MONO = want
        return
    try:
        families = {f.get_name() for f in PangoCairo.FontMap.get_default().list_families()}
    except Exception:                           # noqa: BLE001 - keep the configured name
        families = {want}
    if want in families:
        MONO = want
    else:
        _say_once(f"font {want!r} is not installed; using monospace (icons will not show)")
        MONO = "monospace"


def slot_action(slot, kind):
    """The configured tap or hold action of a slot: a string, or None for no action."""
    a = (CFG["slots"].get(slot) or {}).get(kind)
    return None if a in (None, "", "none") else a


def action_problem(action):
    """Why an action string is not runnable as written, or None."""
    if action is None:
        return None
    if not isinstance(action, str):
        return "not a string"
    if action.startswith("sh:"):
        return None if action[3:].strip() else "empty sh: command"
    if action.startswith("hwdeck:"):
        return None if action[7:] in HWDECK_VIEWS else f"unknown hwdeck view {action[7:]!r}"
    return None if action in BUILTINS else "unknown action"


def helper(name):
    """A helper's absolute path from config "helpers", or None when it is not there. A bare
    name is looked up on the session's PATH."""
    v = CFG["helpers"].get(name)
    if not v:
        return None
    v = os.path.expanduser(v)
    if "/" in v:
        return v if os.path.isfile(v) and os.access(v, os.X_OK) else None
    return shutil.which(v, path=desktop_env().get("PATH"))


def helper_file(name):
    """A helper path that is a file, not a program (state files), with ~ expanded."""
    v = CFG["helpers"].get(name)
    return Path(os.path.expanduser(v)) if v else None


def app_id(what):
    return f"{CFG.get('app_id_prefix') or DEFAULTS['app_id_prefix']}.{what}"


def refresh_signal():
    v = CFG["helpers"].get("refresh_signal") or DEFAULTS["helpers"]["refresh_signal"]
    v = os.path.expanduser(v)
    return Path(v) if "/" in v else \
        Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / v


# --- data ------------------------------------------------------------------------------------
class Machine:
    """CPU history, temperature, memory and battery from /proc and /sys."""

    def __init__(self):
        self.cpu = deque([0.0] * 60, maxlen=60)
        self._last = None
        self.fan_pct, self.fan_frac, self.charging = None, 0.0, False
        self.levels = {}
        self.hints = {}

    def sample(self):
        with open("/proc/stat") as f:
            vals = [int(v) for v in f.readline().split()[1:]]
        idle, total = vals[3] + vals[4], sum(vals)
        if self._last:
            dt, di = total - self._last[1], idle - self._last[0]
            self.cpu.append(0.0 if dt <= 0 else 100.0 * (1 - di / dt))
        self._last = (idle, total)
        fan = self.fan()
        self.fan_pct, self.fan_frac = fan if fan else (None, 0.0)
        self.read_levels()
        self.charging = self.battery()[1] == "Charging"

    @staticmethod
    def temp():
        best = None
        for hw in Path("/sys/class/hwmon").glob("hwmon*"):
            try:
                if (hw / "name").read_text().strip() != "coretemp":
                    continue
                for t in hw.glob("temp*_input"):
                    v = int(t.read_text()) / 1000
                    best = v if best is None else max(best, v)
            except (OSError, ValueError):
                continue
        return best

    @staticmethod
    def fan():
        """Busiest fan: (% of its own maximum RPM, 0-1 position between its min and max RPM)."""
        best = None
        for f in Path("/sys/devices/platform/applesmc.768").glob("fan*_input"):
            try:
                rpm = int(f.read_text())
                top = int(f.with_name(f.name.replace("input", "max")).read_text())
                low = int(f.with_name(f.name.replace("input", "min")).read_text())
            except (OSError, ValueError):
                continue
            if top > low:
                level = (100.0 * rpm / top, min(1.0, max(0.0, (rpm - low) / (top - low))))
                best = level if best is None or level > best else best
        return best

    def read_levels(self):
        """Screen and keyboard backlight and output volume as 0-1, and whether output is muted."""
        lv = {}
        for key, path in (("screen", "/sys/class/backlight/*"), ("kbd", "/sys/class/leds/*kbd_backlight*")):
            for d in Path("/").glob(path.lstrip("/")):
                try:
                    lv[key] = int((d / "brightness").read_text()) / max(1, int((d / "max_brightness").read_text()))
                except (OSError, ValueError):
                    pass
                break
        try:
            out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True,
                                 text=True, timeout=2, env=desktop_env()).stdout
            lv["vol"] = min(1.0, float(out.split()[1]))
            lv["muted"] = "MUTED" in out
        except (OSError, subprocess.SubprocessError, IndexError, ValueError):
            pass
        self.levels = lv
        self.read_light()

    def read_light(self):
        if not CFG["dials"].get("hints", True):
            self.hints = {}
            return
        self._read_light()

    def _read_light(self):
        """Ambient light (lux) from the ALS, smoothed over ~10 s, and the levels it suggests: the
        screen brighter in a brighter room, the keyboard light the other way round. Hints only;
        nothing is changed."""
        try:
            lux = float(next(Path("/sys/bus/iio/devices").glob("iio:device*/in_illuminance_raw"))
                        .read_text())
        except (StopIteration, OSError, ValueError):
            self.hints = {}
            return
        prev = getattr(self, "_lux", None)
        self._lux = lux if prev is None else prev + (lux - prev) * 0.2     # 2 s samples, ~10 s
        g = math.log10(self._lux + 1)
        self.hints = {"screen": min(1.0, max(0.15, 0.15 + 0.30 * g)),
                      "kbd": 0.0 if self._lux > 200 else min(0.7, max(0.0, 1.0 - 0.45 * g))}   # dark room: 70 %, not max

    def system_watts(self):
        """(watts, what it covers). Best first: the SMC's own whole-system reading (PSTR, published
        by a root SMC reader at helpers.smc_power, AC or battery alike); else the battery's
        discharge on battery; else the CPU package from RAPL when readable; else (None, "power")."""
        try:
            smc = json.loads(helper_file("smc_power").read_text())
            if time.time() - smc["t"] < 10:
                for key, scope in (("PSTR", "system"), ("PDTR", "adapter")):
                    if smc["watts"].get(key, 0) > 0.3:
                        return smc["watts"][key], scope
        except (OSError, ValueError, KeyError, TypeError):
            pass
        except AttributeError:                  # no smc_power configured
            pass
        w = self.watts()
        if w is not None and w < -0.5:
            return -w, "system"
        rapl = Path("/sys/class/powercap/intel-rapl:0/energy_uj")
        try:
            e, t = int(rapl.read_text()), time.monotonic()
        except (OSError, ValueError):
            return None, "power"
        last, self._rapl = getattr(self, "_rapl", None), (e, t)
        if not last or t - last[1] > 30 or e < last[0]:
            return getattr(self, "_rapl_w", None), "cpu pkg"
        self._rapl_w = (e - last[0]) / 1e6 / (t - last[1])
        return self._rapl_w, "cpu pkg"

    @staticmethod
    def on_ac():
        try:
            return Path("/sys/class/power_supply/ADP1/online").read_text().strip() == "1"
        except OSError:
            return False

    @staticmethod
    def watts():
        """Battery power in watts: positive while charging, negative while discharging, or None."""
        b = Path("/sys/class/power_supply/BAT0")
        try:
            w = int((b / "current_now").read_text()) * int((b / "voltage_now").read_text()) / 1e12
            status = (b / "status").read_text().strip()
        except (OSError, ValueError):
            return None
        return -abs(w) if status == "Discharging" else abs(w)

    @staticmethod
    def mem():
        info = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, v = line.split(":")
                info[k] = int(v.split()[0])
        return 100.0 * (1 - info["MemAvailable"] / info["MemTotal"])

    @staticmethod
    def battery():
        """(charge %, status). charge_now / charge_full, as Omarchy shows it: BAT0/capacity divides
        by the design capacity and reads ~11 points low on this worn battery."""
        b = Path("/sys/class/power_supply/BAT0")
        try:
            pct = 100 * int((b / "charge_now").read_text()) / int((b / "charge_full").read_text())
            return min(100, round(pct)), (b / "status").read_text().strip()
        except (OSError, ValueError, ZeroDivisionError):
            return None, ""

    @staticmethod
    def wifi():
        """Wi-Fi signal as 0-100 (2 x (dBm + 100), NetworkManager's scale), or None when no
        wireless link is up."""
        try:
            for line in Path("/proc/net/wireless").read_text().splitlines()[2:]:
                dbm = float(line.split()[3].rstrip("."))
                return max(0, min(100, round(2 * (dbm + 100))))
        except (OSError, IndexError, ValueError):
            pass
        return None

    @staticmethod
    def charge_limit():
        """The charge hold (applesmc's BCLM knob, from a patched driver), or 100 when there is none."""
        try:
            return int(Path("/sys/devices/platform/applesmc.768/charge_control_end_threshold")
                       .read_text())
        except (OSError, ValueError):
            return 100


class ClaudeCode:
    """The `claude-code` agent provider: Claude Code sessions on this machine (their processes and
    transcripts under ~/.claude/projects), else the newest commit across agent.projects."""

    def __init__(self):
        self._cpu = {}
        self.sessions = 0
        self.busy = False
        self.commit = None
        self._commit_at = 0.0
        self.work = None
        self.waiting = False

    def sample(self):
        sessions, busy, seen, cwds, children = 0, False, {}, [], False
        for p in Path("/proc").iterdir():
            if not p.name.isdigit():
                continue
            try:
                cmd = (p / "cmdline").read_bytes().split(b"\0")
                if not cmd or not cmd[0].endswith(b"/claude") or b"remote-control" in cmd:
                    continue
                fields = (p / "stat").read_text().rsplit(")", 1)[1].split()
                ticks = int(fields[11]) + int(fields[12])
            except (OSError, IndexError, ValueError):
                continue
            sessions += 1
            seen[p.name] = ticks
            if ticks - self._cpu.get(p.name, ticks) > 5:   # >5 ticks in a 2 s sample
                busy = True
            try:
                cwds.append(os.readlink(p / "cwd"))
                if (p / "task" / p.name / "children").read_text().strip():
                    children = True
            except OSError:
                pass
        self._cpu, self.sessions, self.busy = seen, sessions, busy
        self.work = current_work(cwds)
        # Waiting for you: no CPU, and the newest transcript ends on a tool call with no result
        # yet that is a question to you, or that has no process running (a permission prompt).
        # A pending call with a child process is a long command still running: working.
        pending = pending_tool(self.work[5]) if self.work else None
        self.waiting = bool(sessions and not busy and pending
                            and (pending in ASKS or not children))
        if sessions and not busy and pending and not self.waiting:
            self.busy = True
        if time.time() - self._commit_at > 60:
            self._commit_at = time.time()
            self.commit = self._newest_commit()

    def status(self):
        """The provider interface: what the agent zone draws."""
        state = "none" if self.sessions == 0 else "waiting" if self.waiting else \
            "working" if self.busy else "idle"
        out = {"state": state, "count": self.sessions, "task": "", "step": "", "progress": None}
        if self.sessions and self.work and self.work[0]:
            task, step, started, updated, prog = self.work[:5]
            out["task"] = task
            out["step"] = f"{since(updated)} · {step}" if step else \
                f"started {ago(time.time() - started)} ago"
            s = prog.summary()
            if s:
                out["progress"], out["active"] = [s[0], s[1]], s[2]
            out["steps"], out["started"] = prog.steps, started
        elif self.commit:
            ts, repo, branch, subject = self.commit
            out["task"] = f"{repo} · {branch} · {ago(time.time() - ts)} ago"
            out["step"], out["fresh"] = subject, time.time() - ts < 3600
        return out

    @staticmethod
    def _newest_commit():
        best = None
        projects = CFG["agent"].get("projects")
        if not projects:
            return None
        root = Path(os.path.expanduser(projects))
        try:
            repos = list(root.iterdir())
        except OSError:
            return None
        for repo in repos:
            if not (repo / ".git").exists() or repo.name.startswith("_"):
                continue
            try:
                out = subprocess.run(
                    ["git", "-C", str(repo), "for-each-ref", "--sort=-committerdate", "--count=1",
                     "--format=%(committerdate:unix)%09%(refname:short)%09%(subject)", "refs/heads"],
                    capture_output=True, text=True, timeout=5).stdout.strip()
            except (OSError, subprocess.SubprocessError):
                continue
            if not out:
                continue
            ts, branch, subject = out.split("\t", 2)
            if best is None or int(ts) > best[0]:
                best = (int(ts), repo.name, branch, subject)
        return best


class CommandProvider:
    """The `command` agent provider: agent.command is run every 2 s (in its own thread, so a slow
    script never stalls the bar) and prints one JSON line:
      {"state": "working|waiting|idle|none", "count": n, "task": "...", "step": "...",
       "progress": [done, total] or null}
    Anything else, or a script that fails, shows as state "none"."""

    def __init__(self):
        self.last = {"state": "none", "count": 0, "task": "", "step": "", "progress": None}
        self.busy = False
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        while True:
            cmd = CFG["agent"].get("command")
            if CFG["agent"].get("provider") == "command" and cmd:
                try:
                    out = subprocess.run(["sh", "-c", cmd], capture_output=True, text=True,
                                         timeout=5, env=desktop_env()).stdout.strip().splitlines()
                    d = json.loads(out[-1]) if out else {}
                    if not isinstance(d, dict):
                        raise ValueError("not an object")
                    st = d.get("state") if d.get("state") in ("working", "waiting", "idle", "none") else "none"
                    prog = d.get("progress")
                    prog = prog if isinstance(prog, list) and len(prog) == 2 and all(
                        isinstance(v, int) for v in prog) and prog[1] > 0 else None
                    self.last = {"state": st, "count": int(d.get("count") or 0),
                                 "task": str(d.get("task") or ""), "step": str(d.get("step") or ""),
                                 "progress": prog}
                except (OSError, subprocess.SubprocessError, ValueError, TypeError) as e:
                    _say_once(f"agent command: {e}")
                    self.last = {"state": "none", "count": 0, "task": "", "step": "", "progress": None}
            time.sleep(2)

    def sample(self):
        self.busy = self.last["state"] == "working"

    def status(self):
        return self.last


class Agent:
    """The agent zone's data: the configured provider, or nothing when the zone is not shown
    (then no transcript is read and no command runs)."""

    def __init__(self):
        self._claude, self._command = None, None
        self.busy = False

    def provider(self):
        if not {"agent", "progress", "dock"} & set(CFG["zones"]):
            return None
        if CFG["agent"].get("provider") == "command":
            self._command = self._command or CommandProvider()
            return self._command
        self._claude = self._claude or ClaudeCode()
        return self._claude

    def sample(self):
        p = self.provider()
        if p:
            p.sample()
        self.busy = bool(p and p.busy)

    def status(self):
        p = self.provider()
        return p.status() if p else {"state": "none", "count": 0, "task": "", "step": "",
                                     "progress": None}


CLAUDE_PROJECTS = HOME / ".claude" / "projects"
_task_cache = {}


def current_work(cwds):
    """The task and latest step of the most recently active Claude session, from its transcript.

    Claude Code keeps one jsonl per session under ~/.claude/projects/<cwd with / and . as ->.
    Returns (task, step, started_unix, updated_unix, TaskProgress) or None."""
    best = None
    for cwd in set(cwds):
        folder = CLAUDE_PROJECTS / re.sub(r"[/.]", "-", cwd)
        try:
            path = max(folder.glob("*.jsonl"), key=lambda f: f.stat().st_mtime)
            mtime = path.stat().st_mtime
        except (OSError, ValueError):
            continue
        if best is None or mtime > best[1]:
            best = (path, mtime)
    if best is None:
        return None
    path, mtime = best
    if path not in _task_cache:
        _task_cache[path] = _first_task(path)
    task, started = _task_cache[path]
    return task, _latest_step(path), started, mtime, _progress.read(path), path


def _entries(lines):
    for line in lines:
        try:
            yield json.loads(line)
        except ValueError:
            continue


def _plain(text):
    """A prompt as a one-liner: slash command + args, tags and whitespace folded."""
    m = re.search(r"<command-name>(.*?)</command-name>.*?<command-args>(.*?)</command-args>", text, re.S)
    if m:
        text = f"{m.group(1)} {m.group(2)}"
    text = re.sub(r"<[^>]+>", " ", text)
    return " ".join(text.split())


def _first_task(path):
    try:
        with path.open(errors="replace") as f:
            for e in _entries(f):
                if e.get("type") != "user" or e.get("isSidechain"):
                    continue
                content = e.get("message", {}).get("content")
                if isinstance(content, list):
                    content = " ".join(c.get("text", "") for c in content if c.get("type") == "text")
                if content and content.strip():
                    ts = e.get("timestamp", "")
                    try:
                        started = time.mktime(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")) - time.timezone
                    except ValueError:
                        started = path.stat().st_mtime
                    return _plain(content), started
    except OSError:
        pass
    return "", 0.0


ASKS = {"AskUserQuestion", "ExitPlanMode"}


def pending_tool(path):
    """The name of the newest main-thread tool call that has no result yet, or None."""
    try:
        with path.open("rb") as f:
            f.seek(max(0, path.stat().st_size - 256 * 1024))
            lines = f.read().decode(errors="replace").splitlines()[1:]
    except OSError:
        return None
    for e in reversed(list(_entries(lines))):
        if e.get("isSidechain") or e.get("type") not in ("user", "assistant"):
            continue
        content = e.get("message", {}).get("content")
        if not isinstance(content, list):
            return None                         # a plain prompt or reply: nothing pending
        if e["type"] == "user":
            if any(isinstance(c, dict) and c.get("type") == "tool_result" for c in content):
                return None                     # the newest call already has its result
            continue
        uses = [c for c in content if isinstance(c, dict) and c.get("type") == "tool_use"]
        if uses:
            return uses[-1].get("name")
        if any(isinstance(c, dict) and c.get("type") == "text" for c in content):
            return None                         # turn ended on text
    return None


def _latest_step(path):
    """What the session did last: its newest tool call (by description/target) or text."""
    try:
        with path.open("rb") as f:
            f.seek(max(0, path.stat().st_size - 256 * 1024))
            lines = f.read().decode(errors="replace").splitlines()[1:]
    except OSError:
        return ""
    for e in reversed(list(_entries(lines))):
        if e.get("type") != "assistant":
            continue
        for c in reversed(e.get("message", {}).get("content") or []):
            if c.get("type") == "tool_use":
                i = c.get("input") or {}
                what = (i.get("description") or i.get("file_path") or i.get("pattern")
                        or i.get("command") or i.get("prompt") or "")
                if isinstance(what, str) and what.startswith(str(HOME)):
                    what = "~" + what[len(str(HOME)):]
                return f"{c.get('name')}: {' '.join(str(what).split())}"
            if c.get("type") == "text" and c.get("text", "").strip():
                return " ".join(c["text"].split())
    return ""


class TaskProgress:
    """The session's own task list, read incrementally from its transcript: TaskCreate/TaskUpdate
    (ids from the "Task #N" result) or the newest TodoWrite list. Also counts tool calls."""

    def __init__(self):
        self.path, self.offset = None, 0
        self.tasks, self.todos, self.steps, self._pending = {}, None, 0, {}

    def read(self, path):
        if path != self.path:
            self.__init__()
            self.path = path
        try:
            with path.open("rb") as f:
                f.seek(self.offset)
                chunk = f.read()
        except OSError:
            return self
        cut = chunk.rfind(b"\n") + 1           # leave a half-written last line for next time
        self.offset += cut
        for e in _entries(chunk[:cut].decode(errors="replace").splitlines()):
            if e.get("isSidechain"):
                continue
            for c in e.get("message", {}).get("content") or []:
                if not isinstance(c, dict):
                    continue
                if c.get("type") == "tool_use":
                    self._use(c)
                elif c.get("type") == "tool_result" and c.get("tool_use_id") in self._pending:
                    self._result(c)
        return self

    def _use(self, c):
        self.steps += 1
        name, i = c.get("name"), c.get("input") or {}
        if name == "TodoWrite" and isinstance(i.get("todos"), list):
            self.todos = [(t.get("activeForm") or t.get("content", ""), t.get("status"))
                          for t in i["todos"] if isinstance(t, dict)]
        elif name == "TaskCreate":
            self._pending[c.get("id")] = i.get("activeForm") or i.get("subject", "")
        elif name == "TaskUpdate" and str(i.get("taskId", "")) in self.tasks:
            subject, status = self.tasks[str(i["taskId"])]
            self.tasks[str(i["taskId"])] = (i.get("activeForm") or subject, i.get("status") or status)

    def _result(self, c):
        subject = self._pending.pop(c.get("tool_use_id"))
        text = c.get("content")
        if isinstance(text, list):
            text = " ".join(x.get("text", "") for x in text if isinstance(x, dict))
        m = re.search(r"#(\d+)", str(text or ""))
        self.tasks[m.group(1) if m else str(len(self.tasks) + 1)] = (subject, "pending")

    def summary(self):
        """(done, total, active label) from the task list, or None when the session keeps none."""
        items = self.todos if self.todos is not None else [
            v for v in self.tasks.values() if v[1] != "deleted"]
        if not items:
            return None
        done = sum(1 for _, st in items if st == "completed")
        active = next((lbl for lbl, st in items if st == "in_progress"), "")
        return done, len(items), active


_progress = TaskProgress()

class Ambient:
    """Room loudness from the built-in mic, for the volume dial's hint. Levels only: a 1 s sample
    every 6 s is reduced to one dBFS figure and smoothed over ~15 s; no audio is kept or written.
    Off unless dials.room_loudness is true. On 2016-2019 MacBooks the built-in mic needs a patched
    CS8409 codec driver; with the stock one the mic is silent and no hint shows."""

    def __init__(self):
        self.db = None
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        # Short samples, not an open mic: every 6 s record 1.5 s, drop the first 0.5 s (the stream's
        # start-up click), reduce the last second to one dBFS figure.
        while True:
            if not CFG["dials"].get("room_loudness"):
                self.db = None
                time.sleep(6)
                continue
            try:
                out = subprocess.run(["timeout", "1.5", "pw-record", "--rate", "8000", "--channels",
                                      "1", "--format", "s16", "-"], capture_output=True,
                                     env=desktop_env()).stdout
                a = array.array("h", out[8000:24000][:len(out[8000:24000]) // 2 * 2])
                if len(a) > 4000:
                    m = sum(a) / len(a)
                    rms = math.sqrt(sum((x - m) ** 2 for x in a) / len(a))
                    db = 20 * math.log10(max(rms, 0.5) / 32768)
                    self.db = db if self.db is None else self.db + (db - self.db) * 0.35   # ~15 s
            except OSError:
                pass
            time.sleep(4.5)

    def hint(self):
        """Suggested volume: quiet room (-60 dBFS) 25%, loud room (-25 dBFS) 85%; None if silent."""
        if self.db is None or self.db < -85:
            return None
        return min(0.85, max(0.25, 0.25 + (self.db + 60) / 35 * 0.60))


def orbit(now=None):
    """The OLED-care drift for this moment: (dx, dy) px, or (0, 0) with oled_care.orbit off."""
    if not CFG["oled_care"].get("orbit", True):
        return 0, 0
    return ORBIT[int((time.time() if now is None else now) // ORBIT_EVERY) % len(ORBIT)]


def screen_off():
    """The laptop panel is blanked (DPMS Off): idle, lock screen dark, or lid closed."""
    for f in Path("/sys/class/drm").glob("*eDP*/dpms"):
        try:
            return f.read_text().strip() == "Off"
        except OSError:
            return False
    return False


def session_locked():
    """True while the compositor holds a session lock (as omarchy-hyprland-session-locked: a LOCK
    in some monitor's solitaryBlockedBy); None when that cannot be read (callers fail closed)."""
    try:
        r = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True,
                           timeout=2, env=desktop_env())
        mons = json.loads(r.stdout) if r.returncode == 0 and r.stdout else None
    except (OSError, subprocess.SubprocessError, ValueError):
        mons = None
    if not isinstance(mons, list) or not mons:
        return None
    return any("LOCK" in (m.get("solitaryBlockedBy") or []) for m in mons)


_act_check = (0.0, False)


def may_act():
    """Whether a touch may run anything: only when the session is known to be unlocked. Asked
    right before an action fires (at most every 0.25 s), so the 1 s lock poll leaves no gap and a
    failing hyprctl blocks actions instead of allowing them."""
    global _act_check
    if time.time() - _act_check[0] > 0.25:
        _act_check = (time.time(), session_locked() is False)
    return _act_check[1]


def touch_id_overlay():
    """The cosmetic Touch ID state, or None. A missing file or dead producer is no overlay."""
    try:
        rec = json.loads(TOUCH_ID_STATE.read_text())
        pid = int(rec["pid"])
    except (OSError, ValueError, KeyError, TypeError):
        return None
    try:
        os.kill(pid, 0)
    except PermissionError:
        pass                        # the root producer is alive, we just may not signal it
    except OSError:
        return None
    state = rec.get("state")
    if state not in ("enrollment", "authenticate", "approve", "retry", "success"):
        return None
    return state, rec.get("progress")


_session_env = (0.0, {})


def desktop_env():
    """The graphical session's environment for anything we launch. The Touch Bar service can start
    before Hyprland/uwsm export WAYLAND_DISPLAY, XDG_SESSION_TYPE, the full PATH etc. into the user
    manager, so its own environment lacks them and terminal apps cannot open a window; re-read them
    from `systemctl --user show-environment` (cached 30 s) and fall back to finding the live
    Hyprland socket."""
    global _session_env
    if time.time() - _session_env[0] > 30:
        fresh = {}
        try:
            out = subprocess.run(["systemctl", "--user", "show-environment"], capture_output=True,
                                 text=True, timeout=3).stdout
            for line in out.splitlines():
                k, _, v = line.partition("=")
                if k and not v.startswith("$'"):
                    fresh[k] = v
        except (OSError, subprocess.SubprocessError):
            pass
        _session_env = (time.time(), fresh)
    env = dict(os.environ)
    env.update(_session_env[1])
    if "/usr/share/omarchy/bin" not in env.get("PATH", ""):
        env["PATH"] = env.get("PATH", "/usr/bin") + ":/usr/share/omarchy/bin"
    hypr = Path(env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hypr"
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig or not (hypr / sig / ".socket.sock").exists():
        live = sorted((p for p in hypr.glob("*/.socket.sock")), key=lambda p: p.stat().st_mtime)
        if live:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = live[-1].parent.name
    return env

CHILDREN = []


def run_control(command):
    """Fire and forget, like a key binding; never let a slow helper stall the bar."""
    CHILDREN[:] = [c for c in CHILDREN if c.poll() is None]     # reap the finished ones
    try:
        CHILDREN.append(subprocess.Popen(command, env=desktop_env(), stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True))
    except OSError as e:
        log(f"control {command[0]} failed: {e}")


def ago(seconds):
    seconds = max(0, int(seconds))
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


