class Painter:
    def __init__(self, width, height):
        self.w, self.h = width, height
        self.surface = cairo.ImageSurface(cairo.FORMAT_RGB24, width, height)   # = XRGB8888 LE
        self.cr = cairo.Context(self.surface)

    def text(self, x, y, s, size=17, color=TEXT, font=FONT, weight="Medium", width=None,
             align="left"):
        cr = self.cr
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription(f"{font} {weight} {size}px"))
        layout.set_text(s, -1)
        if width:
            layout.set_width(int(width * Pango.SCALE))
            layout.set_ellipsize(Pango.EllipsizeMode.END)
            layout.set_alignment({"left": Pango.Alignment.LEFT, "center": Pango.Alignment.CENTER,
                                  "right": Pango.Alignment.RIGHT}[align])
        _, logical = layout.get_pixel_extents()
        cr.set_source_rgb(*color)
        cr.move_to(x, y - logical.height / 2)
        PangoCairo.show_layout(cr, layout)
        return logical.width

    def icon(self, cx, cy, s, size=30, color=TEXT, angle=0.0, font=None):
        """One glyph centred on its ink, not its advance (Nerd Font icons sit off-centre),
        optionally turned by `angle` radians about that centre."""
        cr = self.cr
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription(f"{font or MONO} {size:.1f}px"))
        layout.set_text(s, -1)
        ink, _ = layout.get_pixel_extents()
        cr.save()
        cr.translate(cx, cy)
        cr.rotate(angle)
        cr.set_source_rgb(*color)
        cr.move_to(-ink.x - ink.width / 2, -ink.y - ink.height / 2)
        PangoCairo.show_layout(cr, layout)
        cr.restore()

    def label(self, x, y, glyph, color, s):
        """A small coloured icon then a dim label: the machine zone's headings."""
        self.icon(x + 6, y, glyph, size=13, color=color)
        self.text(x + 15, y, s, size=12, color=DIM)

    def plate(self, x, w, color=PLATE, r=8):
        cr = self.cr
        h = self.h
        cr.new_sub_path()
        cr.arc(x + w - r, r, r, -1.5708, 0)
        cr.arc(x + w - r, h - r, r, 0, 1.5708)
        cr.arc(x + r, h - r, r, 1.5708, 3.1416)
        cr.arc(x + r, r, r, 3.1416, 4.7124)
        cr.close_path()
        cr.set_source_rgb(*color)
        cr.fill()

    def esc_key(self, pressed=False):
        """Esc as its own kind of key: a red pill (every other key is a grey plate) holding the ISO escape symbol drawn by hand: a circle broken at its
        upper left, an arrow leaving through the gap."""
        cr, h, w = self.cr, self.h, ESC_W
        r, inset = (h - 8) / 2, 4
        cr.new_sub_path()
        cr.arc(w - inset - r, h / 2, r, -math.pi / 2, math.pi / 2)
        cr.arc(inset + r, h / 2, r, math.pi / 2, 3 * math.pi / 2)
        cr.close_path()
        cr.set_source_rgb(*((0.80, 0.20, 0.17) if pressed else (0.62, 0.13, 0.11)))   # a red pill
        cr.fill()
        cx, cy, rr = w / 2 + 3, h / 2 + 3, 11
        cr.set_line_width(2.4)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_source_rgb(*TEXT)
        cr.arc(cx, cy, rr, -0.62 * math.pi, 1.12 * math.pi)     # open towards the upper left
        cr.stroke()
        tip = (cx - 17, cy - 17)
        cr.move_to(cx - 2, cy - 2)
        cr.line_to(*tip)
        cr.stroke()
        cr.move_to(tip[0] + 8, tip[1])
        cr.line_to(*tip)
        cr.line_to(tip[0], tip[1] + 8)
        cr.stroke()
        cr.set_line_cap(cairo.LINE_CAP_BUTT)

    def sign(self, x, w, word, color, t, life, icon=None):
        """The lock sign: a padlock and `word` in the middle of a black band, each letter
        decoding out of scrambling katakana (settling DECODE_STEP s after the one before, the
        padlock first), the way the screen's rain glitched. `t` is the time since it began,
        `life` how long the lock has lasted: full strength for 30 s, then dimming to a third over
        10 s (the OLED shows it as long as the machine stays locked)."""
        k = 1.0 if life < 30 else max(0.35, 1 - 0.65 * (life - 30) / 10)
        c = tuple(v * k for v in color)
        adv, size = 26, 28
        lead = 44                                        # the padlock and its gap
        x0 = x + (w - lead - adv * len(word)) / 2 + adv          # one letter right of centre
        mid = self.h / 2
        if t > 0.05:
            self.icon(x0 + 14, mid, icon or (ICON_OPEN if word.startswith("UN") else ICON_LOCK), size=24, color=c)
        for i, ch in enumerate(word):
            settle = 0.15 + DECODE_STEP * i
            if t < settle - 0.45:
                continue                                 # not started yet
            ch_ = ch if t >= settle else random.choice(KATAKANA)
            cc = c if t >= settle else tuple(v * 0.7 for v in c)
            self.text(x0 + lead + adv * i, mid, ch_, size=size, weight="Bold", font=MONO, color=cc,
                      width=adv, align="center")

    def dot(self, x, y, r, color):
        self.cr.arc(x, y, r, 0, 6.2832)
        self.cr.set_source_rgb(*color)
        self.cr.fill()

    def spark(self, x, y0, w, h, values, color):
        cr = self.cr
        n = len(values)
        cr.move_to(x, y0 + h)
        for i, v in enumerate(values):
            cr.line_to(x + w * i / (n - 1), y0 + h - h * min(v, 100) / 100)
        cr.line_to(x + w, y0 + h)
        cr.close_path()
        cr.set_source_rgba(*color, 0.35)
        cr.fill_preserve()
        cr.new_path()
        for i, v in enumerate(values):
            cr.line_to(x + w * i / (n - 1), y0 + h - h * min(v, 100) / 100)
        cr.set_source_rgb(*color)
        cr.set_line_width(1.5)
        cr.stroke()

    def clear(self):
        self.cr.set_source_rgb(*BG)
        self.cr.paint()


def slot_rects(width):
    """The stock 13-slot row: Esc then F1..F12, evenly spread with gaps."""
    sw = (width - GAP * (SLOTS - 1)) / SLOTS
    return [(i * (sw + GAP), sw) for i in range(SLOTS)]


def local_zone_city():
    """The city of the local time zone (/etc/localtime -> .../Europe/Rome -> Rome), or ""."""
    try:
        target = os.readlink("/etc/localtime")
    except OSError:
        return ""
    return target.rsplit("/", 1)[-1].replace("_", " ") if "zoneinfo" in target else ""


def zone_clock(p, x, w, mid, model):
    """The clock in 7-segment digits, its label (clock.label, default the zone's city) and an
    optional line about the next full hour (clock.hour_mark, "{m}" = minutes to it)."""
    c = CFG["clock"]
    tz = c.get("timezone")
    if tz:
        from zoneinfo import ZoneInfo
        now = datetime.now(ZoneInfo(tz))
        label = c.get("label") if c.get("label") is not None else tz.rsplit("/", 1)[-1].replace("_", " ")
    else:
        now = datetime.now()
        label = c.get("label") if c.get("label") is not None else local_zone_city()
    cw = seven_seg(p, x, mid, now.strftime("%H:%M"), TEXT, h=38, w=21, t=5.5, gap=5)
    mark = c.get("hour_mark")
    mark = mark.replace("{m}", str(60 - now.minute)) if isinstance(mark, str) else None
    if label and mark:
        p.text(x + cw + 14, mid - 10, label, size=13, color=DIM, width=w - cw - 14)
        p.text(x + cw + 14, mid + 10, mark, size=13, color=DIM, width=w - cw - 14)
    elif label or mark:
        p.text(x + cw + 14, mid, label or mark, size=13, color=DIM, width=w - cw - 14)


def since(ts):
    age = time.time() - ts
    return "now" if age < 60 else f"{ago(age)} ago"


SEGMENTS = {"0": "abcdef", "1": "bc", "2": "abged", "3": "abgcd", "4": "fgbc", "5": "afgcd",
            "6": "afgedc", "7": "abc", "8": "abcdefg", "9": "abcdfg"}


def seven_seg(p, x, cy, text, color, h=36, w=20, t=5.5, gap=7):
    """Digits as a 7-segment LED readout: lit segments in `color` with a soft glow, unlit ones
    faintly visible, like a game or calculator display. Returns the width drawn."""
    cr = p.cr
    half = h / 2
    def seg(name, x0):
        y0 = cy - half
        horiz = {"a": y0, "g": cy, "d": y0 + h}
        vert = {"f": (x0, y0, cy), "b": (x0 + w, y0, cy), "e": (x0, cy, y0 + h),
                "c": (x0 + w, cy, y0 + h)}
        k = t / 2
        if name in horiz:                       # hexagon lying flat
            y = horiz[name]
            pts = [(x0 + k + 0.7, y), (x0 + k * 2 + 0.7, y - k), (x0 + w - k * 2 - 0.7, y - k),
                   (x0 + w - k - 0.7, y), (x0 + w - k * 2 - 0.7, y + k), (x0 + k * 2 + 0.7, y + k)]
        else:                                   # hexagon standing up
            xx, ya, yb = vert[name]
            pts = [(xx, ya + k + 0.7), (xx + k, ya + k * 2 + 0.7), (xx + k, yb - k * 2 - 0.7),
                   (xx, yb - k - 0.7), (xx - k, yb - k * 2 - 0.7), (xx - k, ya + k * 2 + 0.7)]
        cr.move_to(*pts[0])
        for pt in pts[1:]:
            cr.line_to(*pt)
        cr.close_path()
    x0 = x + t / 2
    for ch in text:
        if ch == ":":                           # two lit dots, half a digit wide
            for dy in (-h / 4, h / 4):
                cr.rectangle(x0 - t / 2, cy + dy - t / 2, t, t)
            cr.set_source_rgb(*color)
            cr.fill()
            x0 += t + gap
            continue
        lit = SEGMENTS.get(ch, "")
        for name in "abcdefg":
            seg(name, x0)
            if name in lit:
                cr.set_source_rgba(*color, 0.35)       # glow
                cr.set_line_width(3)
                cr.stroke_preserve()
                cr.set_source_rgb(*color)
            else:
                cr.set_source_rgba(*color, 0.10)
            cr.fill()
        x0 += w + gap + t
    return x0 - x - t / 2 - gap


def count_square(p, x, cy, n, color, size=40, line=2.5):
    """A count as one square cut into n cells, up to 25 (a 5 x 5 grid): 1-3 side by side, then
    round(sqrt(n)) rows with the extra cells in the bottom rows (5 = 2 over 3, 7 = 2 / 2 / 3). 0 is an empty outline; over 25
    falls back to 7-segment digits. Returns the width drawn."""
    if n > 25:
        return seven_seg(p, x, cy, str(n), color)
    cr, y0 = p.cr, cy - size / 2
    if n <= 0:
        cr.rectangle(x + 1, y0 + 1, size - 2, size - 2)
        cr.set_source_rgba(*color, 0.5)
        cr.set_line_width(2)
        cr.stroke()
        return size
    rows = 1 if n <= 3 else round(math.sqrt(n))
    base, extra = divmod(n, rows)
    rh = (size + line) / rows
    for r in range(rows):
        cells = base + (1 if r >= rows - extra else 0)
        cw = (size + line) / cells
        for c in range(cells):
            cr.rectangle(x + c * cw, y0 + r * rh, cw - line, rh - line)
    cr.set_source_rgb(*color)
    cr.fill()
    return size


def zone_agent(p, x, w, mid, model):
    """The agent provider's state as a square count (one cell per session), coloured by state
    (green working, blue waiting for you, amber idle, grey none), then its task and latest step."""
    a = model["agent_status"]
    model.setdefault("touch", []).append((x, w, ("agent",), "agent"))
    state, n = a.get("state"), a.get("count") or 0
    state_color = {"waiting": BLUE, "working": GREEN, "idle": AMBER}.get(state, DIM)
    if state == "working" and int(time.time() * 2) % 2:      # the square pulses while working
        state_color = tuple(c * 0.7 for c in state_color)
    lw = count_square(p, x + 4, mid, n, state_color)
    cx, end = x + 4 + lw + 22, x + w
    if a.get("task") and end - cx > 60:
        line = BLUE if state == "waiting" else GREEN if state == "working" or a.get("fresh") else DIM
        p.text(cx, mid - 11, a["task"], size=13, color=line, width=end - cx)
        if a.get("step"):
            p.text(cx, mid + 10, a["step"], size=16, width=end - cx)


BATTERY_GLYPHS = ["\U000f008e", "\U000f007a", "\U000f007b", "\U000f007c", "\U000f007d",
                  "\U000f007e", "\U000f007f", "\U000f0080", "\U000f0081", "\U000f0082",
                  "\U000f0079"]                     # outline, 10 .. 90, full


WIFI_GLYPHS = ["\U000f091f", "\U000f0922", "\U000f0925", "\U000f0928"]   # 1 .. 4 bars


def charge_color(cap, limit):
    """Red when empty, yellow at 50%, green at the charge hold."""
    def mix(a, b, t):
        return tuple(x + (y - x) * min(1.0, max(0.0, t)) for x, y in zip(a, b))
    if cap <= 50:
        return mix(RED, VOLT, cap / 50)
    return mix(VOLT, GREEN, (cap - 50) / max(1, limit - 50))


def heat(value, cool, warm, hot, base):
    """An icon colour that warms with the value: `base` up to `cool`, then toward amber at `warm`
    and red at `hot`."""
    def mix(a, b, t):
        return tuple(x + (y - x) * min(1.0, max(0.0, t)) for x, y in zip(a, b))
    if value <= warm:
        return mix(base, AMBER, (value - cool) / (warm - cool))
    return mix(AMBER, RED, (value - warm) / (hot - warm))


def load_color(value, calm, warn, full):
    """Green up to `calm`, yellow at `warn`, red at `full` (battery/Wi-Fi colours, read the other way)."""
    def mix(a, b, t):
        return tuple(x + (y - x) * min(1.0, max(0.0, t)) for x, y in zip(a, b))
    if value <= warn:
        return mix(GREEN, VOLT, (value - calm) / (warn - calm))
    return mix(VOLT, RED, (value - warn) / (full - warn))


def zone_machine(p, x, w, mid, model):
    """CPU sparkline, temperature + fan, RAM, Wi-Fi, battery and power slots (charge %, watts, AC or battery)."""
    m = model["machine"]
    cpu = m.cpu[-1]
    # Every slot's tap and hold come from config "slots" (see run_action)
    touch = model.setdefault("touch", [])
    touch.append((x, 104, ("slot", "graph"), "graph"))
    touch.append((x + 104, 71, ("slot", "cpu"), "cpu"))
    touch.append((x + 175, 72, ("slot", "thermal"), "thermal"))
    touch.append((x + 247, 70 - 8, ("slot", "memory"), "memory"))
    p.spark(x, 10, 100, p.h - 20, list(m.cpu),
            RED if cpu > 85 else AMBER if cpu > 60 else GREEN)
    p.label(x + 110, mid - 11, "\U000f061a", AMBER if model.get("boost") else heat(cpu, 30, 65, 90, MINT),
            slot_flash(model, "cpu") or ("boost" if model.get("boost") else "CPU"))
    p.text(x + 110, mid + 10, f"{cpu:.0f}%", size=17, font=MONO)
    x += 175
    # Temperature and fans in one slot: the fan icon turns with the fans' speed and takes the
    # temperature's colour (cyan -> amber -> red); heading = fan %, value = CPU temperature.
    t, fan = m.temp(), m.fan_pct
    model["fan_icon"] = (x + 6, mid - 11)
    model["fan_color"] = heat(t, 50, 72, 90, ICE) if t is not None else ICE
    draw_anim(p, model)
    p.text(x + 15, mid - 11, slot_flash(model, "thermal") or ("fan max" if model.get("fan_boost") else
           f"fan {fan:.0f}%" if fan is not None else "temp"), size=12, color=DIM)
    if t is not None:
        p.text(x, mid + 10, f"{t:.0f}°", size=17, font=MONO,
               color=RED if t > 85 else AMBER if t > 70 else TEXT)
    x += 72
    ram = m.mem()
    p.label(x, mid - 11, "\U000f035b", load_color(ram, 50, 75, 92), slot_flash(model, "memory") or "RAM")
    p.text(x, mid + 10, f"{ram:.0f}%", size=17, font=MONO)
    x += 70
    sig = m.wifi()
    model.setdefault("touch", []).append((x - 8, 70, ("slot", "wifi"), "wifi"))
    if sig is None:
        p.label(x, mid - 11, "\U000f05aa", DIM, slot_flash(model, "wifi") or "wifi")
        p.text(x, mid + 10, "off", size=17, font=MONO, color=DIM)
    else:
        bars = WIFI_GLYPHS[min(3, sig // 25)]
        p.label(x, mid - 11, bars, charge_color(sig, 100), slot_flash(model, "wifi") or "wifi")
        p.text(x, mid + 10, f"{sig}%", size=17, font=MONO)
    x += 70
    cap, status = m.battery()
    flash = model.get("slot_flash")
    flash = flash if flash and time.time() < flash[2] else None
    if cap is not None:
        # Battery: the icon empties with the charge and goes red -> yellow -> green toward the
        # charge hold; it breathes while charging. Tap: battery view. Hold: limit 80 <-> 100.
        model["battery_icon"] = (x + 6, mid - 11)
        model["battery_color"] = charge_color(cap, m.charge_limit())
        model["battery_glyph"] = BATTERY_GLYPHS[min(10, max(0, round(cap / 10)))]
        draw_anim(p, model)
        model["touch"].append((x - 8, 70, ("slot", "battery"), "battery"))
        label = flash[1] if flash and flash[0] == "battery" else f"max {m.charge_limit()}" \
            if m.charge_limit() < 100 else "bat"
        p.text(x + 15, mid - 11, label, size=12, color=TEXT if flash and flash[0] == "battery" else DIM)
        p.text(x, mid + 10, f"{cap}%", size=17, font=MONO,
               color=RED if cap < 15 and not m.on_ac() else TEXT)
    x += 70
    # Power: what the machine draws: the SMC's whole-system watts when a reader publishes them,
    # else the battery's discharge on battery, else the CPU package (RAPL) when readable.
    # An amber cup while the lid mode is "awake".
    watts, scope = m.system_watts()
    ac = m.on_ac()                                      # plug in green on AC, unplugged plug in amber
    p.label(x, mid - 11, "\U000f06a5" if ac else "\U000f06a6",
            GREEN if ac else AMBER, flash[1] if flash and flash[0] == "power" else scope)
    p.text(x, mid + 10, f"{watts:.0f}W" if watts is not None else "AC", size=17, font=MONO)
    if lid_mode() == "awake":                           # lid close keeps it working
        p.icon(x + 62, mid + 10, "\U000f0176", size=12, color=AMBER)
    model["touch"].append((x - 8, 70, ("slot", "power"), "power"))



def launch_tui(app, cmd):
    """A terminal window with class `app` running `cmd`: through Omarchy's launch-or-focus
    (helpers.launch_tui) when it is there, else helpers.terminal / $TERMINAL / foot, started
    with --app-id (foot's flag)."""
    tui = helper("launch_tui")
    if tui:
        return [tui, f"--app-id={app}"] + cmd
    term = CFG["helpers"].get("terminal") or desktop_env().get("TERMINAL") or "foot"
    return [term, f"--app-id={app}"] + cmd


def hwdeck_view(view):
    """hwdeck's focused full-screen view in a terminal (focused if that view is already open)."""
    return launch_tui(app_id(f"hwdeck-{view}"), [helper("hwdeck") or "hwdeck", "--view", view])


def set_level(machine, key, frac, off=False):
    """Set the screen or keyboard backlight (brightnessctl, via logind) or the output volume
    (wpctl) to an exact level, and show it at once on the dial."""
    n = round(min(1.0, max(0.0, frac)) * 100)
    if key == "vol":
        run_control(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{n}%"])
    else:
        pattern = "sys/class/backlight/*" if key == "screen" else "sys/class/leds/*kbd_backlight*"
        dev = next(Path("/").glob(pattern), None)
        if dev is None:
            return
        run_control(["brightnessctl", "-q", "-d", dev.name, "set", f"{n if off or key != 'screen' else max(n, 1)}%"])
    machine.levels[key] = n / 100


def dial_level(action, x):
    """Finger position on a dial -> 0..1, with a little dead space at each edge."""
    _, _, dx, dw = action
    return (x - dx - 12) / (dw - 24)


def close_window(app_id):
    """Close the window with this class if one is open; True when it was. Lets a tap toggle."""
    env = desktop_env()
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                                            text=True, timeout=2, env=env).stdout or "[]")
    except (OSError, subprocess.SubprocessError, ValueError):
        return False
    found = [c["address"] for c in clients if c.get("class") == app_id and c.get("address")]
    for addr in found:                          # by address, as Omarchy's close-all does
        subprocess.run(["hyprctl", "dispatch", f'hl.dsp.window.close({{ window = "address:{addr}" }})'],
                       capture_output=True, timeout=2, env=env)
    return bool(found)


def slot_flash(model, slot):
    """A short message on a slot's heading after a hold, for 3 s."""
    f = model.get("slot_flash")
    return f[1] if f and f[0] == slot and time.time() < f[2] else None


def set_profile(name):
    run_control(["powerprofilesctl", "set", name])


WALL = ["cpu", "thermal", "network", "memory", "power", "battery"]


def toggle_wall():
    """The whole hwdeck wall: open every view that is missing, or close all when all are up."""
    try:
        open_now = {c.get("class") for c in json.loads(subprocess.run(
            ["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=2,
            env=desktop_env()).stdout or "[]")}
    except (OSError, subprocess.SubprocessError, ValueError):
        return
    missing = [v for v in WALL if app_id(f"hwdeck-{v}") not in open_now]
    if not missing:
        for v in WALL:
            close_window(app_id(f"hwdeck-{v}"))
        threading.Timer(0.5, sync_wall_bar).start()
        return
    for v in missing:
        run_control(hwdeck_view(v))
    threading.Timer(1.5, sync_wall_bar).start()     # the bar follows the wall soon, not in 2 s


WALL_BAR_MARK = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "touchbar-strip" / "wall-hid-bar"
OMARCHY_BAR_OFF = HOME / ".local" / "state" / "omarchy" / "toggles" / "bar-off"


def sync_wall_bar():
    """wall.hide_bar: while all six hwdeck views are open, Omarchy's bar is hidden (its own
    bar-off toggle, so nothing else is touched); once any of them closes, the bar comes back.
    Only a bar this hid is brought back (a marker file says so), so a bar the user switched off
    stays off, and a marker left over from a crash is cleared on the next check."""
    hide = CFG.get("wall", {}).get("hide_bar") and OMARCHY_BAR_OFF.parent.parent.is_dir()
    try:
        classes = {c.get("class") for c in json.loads(subprocess.run(
            ["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=2,
            env=desktop_env()).stdout or "[]")}
    except (OSError, subprocess.SubprocessError, ValueError):
        return
    wall_up = all(app_id(f"hwdeck-{v}") in classes for v in WALL)
    sync = ["omarchy-shell", "-q", "omarchy.bar", "syncHidden"]
    if hide and wall_up and not OMARCHY_BAR_OFF.exists():
        try:
            OMARCHY_BAR_OFF.parent.mkdir(parents=True, exist_ok=True)
            OMARCHY_BAR_OFF.touch()
            WALL_BAR_MARK.parent.mkdir(parents=True, exist_ok=True)
            WALL_BAR_MARK.touch()
        except OSError:
            return
        run_control(sync)
    elif WALL_BAR_MARK.exists() and not (hide and wall_up):
        try:
            OMARCHY_BAR_OFF.unlink(missing_ok=True)
            WALL_BAR_MARK.unlink(missing_ok=True)
        except OSError:
            return
        run_control(sync)


def toggle_view(view):
    """Tap opens an hwdeck view, tap again closes it."""
    if not close_window(app_id(f"hwdeck-{view}")):
        run_control(hwdeck_view(view))


def open_agent():
    """The agent zone's tap (agent.open): "tmux-attach" shows the running Claude session (a
    terminal attached to the tmux session whose pane runs it, or a new `claude` in
    agent.projects); "sh:<command>" runs that; null does nothing. Tapping again closes the
    terminal (detaching; the session keeps running in tmux)."""
    how = CFG["agent"].get("open")
    if not how or how == "none":
        return
    if isinstance(how, str) and how.startswith("sh:"):
        return run_control(["sh", "-c", how[3:]])
    if how != "tmux-attach":
        _say_once(f"agent.open {how!r} is not tmux-attach, sh:<command> or null")
        return
    app = app_id("claude")
    if close_window(app):
        return
    claude = set()
    for p in Path("/proc").iterdir():
        try:
            cmd = (p / "cmdline").read_bytes().split(b"\0")
            if p.name.isdigit() and cmd[0].endswith(b"/claude") and b"remote-control" not in cmd:
                claude.add(p.name)
                claude.add((p / "stat").read_text().rsplit(")", 1)[1].split()[1])   # its parent
        except (OSError, IndexError):
            continue
    try:
        panes = subprocess.run(["tmux", "list-panes", "-a", "-F", "#{session_name} #{pane_pid}"],
                               capture_output=True, text=True, timeout=3).stdout.split("\n")
    except (OSError, subprocess.SubprocessError):
        panes = []
    for line in panes:
        name, _, pid = line.rpartition(" ")
        if pid in claude:
            return run_control(launch_tui(app, ["tmux", "attach", "-t", name]))
    where = os.path.expanduser(CFG["agent"].get("projects") or "~")
    run_control(launch_tui(app, ["bash", "-lc", f"cd {shlex.quote(where)} && exec claude"]))


CHARGE_KNOB = Path("/sys/devices/platform/applesmc.768/charge_control_end_threshold")
CHARGE_HOLD = 80
BOOST_HOT = 90          # °C: CPU boost switches itself off here
FAN_GOOD = 60           # °C: after the first minute, max fans run until the CPU is back to this
FAN_CAP = 15 * 60       # s: max fans hand back to the SMC after this whatever the temperature


def needs_setup(action):
    """The flash for an action whose helper is missing, with one journal line naming the
    omarchy-mac-kit module that installs it."""
    module = NEEDS.get(action, (None, "?"))[1]
    _say_once(f"{action}: its helper is not installed ({module})")
    return "needs setup"


def root_hw(cmd):
    """Run the root helper (helpers.hw) through its narrow sudo rule: True when it ran, False
    when sudo refused, None when the helper is not installed. t1bridge's t1-touchbar.service
    sets NoNewPrivileges=yes, so sudo cannot elevate from inside it; a transient unit from the
    user manager (systemd-run --user) runs outside that limit."""
    hw = helper("hw")
    if not hw:
        return None
    try:
        return subprocess.run(["systemd-run", "--user", "--wait", "--quiet", "--collect",
                               "sudo", "-n", hw, cmd], capture_output=True, timeout=15,
                              env=desktop_env()).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def do_lock():
    cmd = helper("lock_cmd")
    run_control([cmd] if cmd else ["loginctl", "lock-session"])


def run_action(model, action, now, slot=None):
    """Run one configured action; returns the message to flash on the slot's heading, or ""."""
    if action is None:
        return ""
    problem = action_problem(action)
    if problem:
        _say_once(f"slot {slot}: action {action!r}: {problem}")
        return "bad action"
    if action.startswith("sh:"):
        run_control(["sh", "-c", action[3:]])
        return ""
    if action.startswith("hwdeck:"):
        toggle_view(action[7:])
        return ""
    if action == "wall":
        toggle_wall()
    elif action == "agent-open":
        open_agent()
    elif action == "lock":
        do_lock()
    elif action == "lock-rain":                 # a short screen rain pass, then lock
        rain = helper("rainpass")
        if rain:
            run_control([rain, "--force", "--lock"])
        else:
            needs_setup(action)
            do_lock()
    elif action == "cpu-boost":                 # performance profile until hot or held again
        model["boost"] = not model.get("boost")
        set_profile("performance" if model["boost"] else "balanced")
        return "boost on" if model["boost"] else "boost off"
    elif action == "fans-max":                  # max fans for a minute, then until it cools
        if model.get("fan_boost"):
            model["fan_boost"] = None
            ok = root_hw("fan-auto")
            return needs_setup(action) if ok is None else "fan auto" if ok else "no root"
        ok = root_hw("fan-max")
        if not ok:
            return needs_setup(action) if ok is None else "no root"
        model["fan_boost"] = (now + 60, now + FAN_CAP)
        return "fan max"
    elif action == "mem-trim":
        ok = root_hw("mem-trim")
        return needs_setup(action) if ok is None else "trimmed" if ok else "no root"
    elif action == "wifi-toggle":               # NetworkManager allows this from the session
        run_control(["sh", "-c", "nmcli radio wifi off; sleep 2; nmcli radio wifi on"])
        return "restart"
    elif action == "charge-limit":
        return toggle_charge_limit()
    elif action == "lid-mode":
        return f"lid: {toggle_lid_mode()}"
    return ""


def toggle_lid_mode():
    """Flip what closing the lid does: sleep (lock + power-saver) or awake (keeps working).
    helpers.lid (omk-lid) owns the mode file and the Hyprland lid bindings call it."""
    lid = helper("lid")
    if not lid:
        return needs_setup("lid-mode")
    try:
        return subprocess.run([lid, "toggle"], capture_output=True,
                              text=True, timeout=3, env=desktop_env()).stdout.strip() or "?"
    except (OSError, subprocess.SubprocessError) as e:
        log(f"lid mode: {e}")
        return "needs setup"


def lid_mode():
    try:
        return helper_file("lid_state").read_text().strip() or "sleep"
    except (OSError, AttributeError):
        return "sleep"


def toggle_charge_limit():
    """Flip the charge limit between the 80% hold and 100%; returns the flash label. The knob
    is the patched applesmc's, made writable for you by the battery-limit module."""
    try:
        new = 100 if int(CHARGE_KNOB.read_text()) < 100 else CHARGE_HOLD
        CHARGE_KNOB.write_text(f"{new}\n")
    except (OSError, ValueError) as e:
        log(f"charge limit: {e}")
        return needs_setup("charge-limit")
    state = helper_file("charge_state")
    try:
        if state:
            state.write_text(f"{new}\n")
    except OSError as e:
        log(f"charge limit not kept across reboots: {e}")
    log(f"charge limit set to {new}%")
    return f"max {new}%"


def draw_anim(p, model):
    """The animated icons: the fan turned to its angle, and the plug pulsing while charging.
    Animation frames redraw only these over a cached frame (see run)."""
    if model.get("defer_anim"):
        return
    if model.get("fan_icon"):
        cx, cy = model["fan_icon"]
        p.icon(cx, cy, "\U000f0210", size=13, color=model.get("fan_color", ICE),
               angle=model.get("fan_angle", 0.0))
    if model.get("battery_icon"):
        cx, cy = model["battery_icon"]
        glyph = model["battery_glyph"]
        color, size = model["battery_color"], 13
        if model["machine"].charging:                # a breathing glow, 1 s per breath
            t = 0.5 + 0.5 * math.sin(time.time() * 2 * math.pi)
            color, size = tuple(c * (0.45 + 0.55 * t) for c in color), 13 + t
        p.icon(cx, cy, glyph, size=size, color=color)


def zone_progress(p, x, w, mid, model):
    """The agent's task list (provider "progress": [done, total]): a done/total bar and the
    active item. Shown with agent.progress = true, or "progress" in zones."""
    a = model["agent_status"]
    if a.get("state", "none") == "none" or not a.get("count"):
        p.text(x, mid, "no task running", size=15, color=DIM)
        return
    prog = a.get("progress")
    if not prog:
        p.text(x, mid - 11, "no task list", size=13, color=DIM)
        if a.get("steps") is not None:
            p.text(x, mid + 10, f"{a['steps']} steps · {ago(time.time() - a.get('started', time.time()))}",
                   size=16, font=MONO, width=w)
        return
    done, total = prog
    active = a.get("active", "")
    head = f"{done}/{total}"
    tw = p.text(x, mid - 11, head, size=13, weight="Bold", font=MONO,
                color=GREEN if done == total else TEXT)
    p.text(x + tw + 10, mid - 11, active or ("all done" if done == total else ""), size=13,
           color=DIM, width=w - tw - 10)
    by, bh = mid + 6, 10
    cr = p.cr
    cr.rectangle(x, by, w, bh)
    cr.set_source_rgb(*PLATE)
    cr.fill()
    cr.rectangle(x, by, w * done / total, bh)
    cr.set_source_rgb(*GREEN)
    cr.fill()
    if active and done < total:                 # the item being worked on, pulsing
        cr.rectangle(x + w * done / total, by, w / total, bh)
        cr.set_source_rgba(*AMBER, 0.9 if int(time.time() * 2) % 2 else 0.5)
        cr.fill()


